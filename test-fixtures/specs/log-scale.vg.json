{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Symbols over a logarithmic x scale and a sqrt y scale. The fourth differential fixture: the log axis exercises the tick algorithm's powers-and-multiples path, which is where a port most easily diverges.",
  "width": 300,
  "height": 150,
  "padding": 5,
  "data": [
    {
      "name": "points",
      "values": [
        {"n": 1, "m": 4},
        {"n": 7, "m": 16},
        {"n": 30, "m": 36},
        {"n": 150, "m": 64},
        {"n": 900, "m": 100}
      ]
    }
  ],
  "scales": [
    {"name": "x", "type": "log", "domain": [1, 1000], "range": "width"},
    {"name": "y", "type": "sqrt", "domain": [0, 100], "range": "height"}
  ],
  "axes": [
    {"orient": "bottom", "scale": "x"},
    {"orient": "left", "scale": "y", "tickCount": 5}
  ],
  "marks": [
    {
      "type": "symbol",
      "name": "dots",
      "from": {"data": "points"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "n"},
          "y": {"scale": "y", "field": "m"},
          "size": {"value": 70}
        }
      }
    }
  ]
}
