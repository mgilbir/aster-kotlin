{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A trail: a line whose thickness follows the data, drawn as a filled run of capsules rather than a stroke, beside a plain line through the same points.",
  "width": 240,
  "height": 130,
  "padding": 5,
  "data": [
    {
      "name": "table",
      "values": [
        {"t": 0, "v": 24, "w": 2},
        {"t": 1, "v": 58, "w": 9},
        {"t": 2, "v": 41, "w": 4},
        {"t": 3, "v": 77, "w": 14},
        {"t": 4, "v": 52, "w": 6},
        {"t": 5, "v": 88, "w": 20}
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {"data": "table", "field": "t"},
      "range": "width",
      "zero": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": [0, 100],
      "range": "height"
    }
  ],
  "axes": [
    {"orient": "bottom", "scale": "x", "tickCount": 6},
    {"orient": "left", "scale": "y", "tickCount": 4}
  ],
  "marks": [
    {
      "type": "trail",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "t"},
          "y": {"scale": "y", "field": "v"},
          "size": {"field": "w"},
          "fill": {"value": "#4c78a8"},
          "fillOpacity": {"value": 0.7}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "t"},
          "y": {"scale": "y", "field": "v"},
          "stroke": {"value": "#333333"},
          "strokeWidth": {"value": 1}
        }
      }
    }
  ]
}
