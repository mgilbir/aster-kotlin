              "cursor": {
                "value": "pointer"
              },
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
              },
              "x": {
                "scale": "concat_0_x",
                "field": "c"
              },
              "width": {
                "signal": "max(0.25, bandwidth('concat_0_x'))"
              },
              "y": {
                "scale": "concat_0_y",
                "field": "v_end"
              },
              "y2": {
                "scale": "concat_0_y",
                "field": "v_start"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_0_y",
          "orient": "left",
          "gridScale": "concat_0_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "grid": false,
          "title": "c",
          "labelAlign": "right",
          "labelAngle": 270,
          "labelBaseline": "middle",
