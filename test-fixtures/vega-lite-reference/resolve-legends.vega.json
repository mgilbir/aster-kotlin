{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Two plots whose colour scales are resolved apart, so each carries its own key.",
  "background": "white",
  "padding": 5,
  "height": 90,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "category": "Alpha",
          "amount": 28,
          "score": 3,
          "band": "low"
        },
        {
          "category": "Beta",
          "amount": 55,
          "score": 7,
          "band": "high"
        },
        {
          "category": "Gamma",
          "amount": 43,
          "score": 5,
          "band": "low"
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "category"
          ],
          "field": "amount",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "amount_start",
            "amount_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"amount\"]) && isFinite(+datum[\"amount\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"score\"]) && isFinite(+datum[\"score\"]) && isValid(datum[\"amount\"]) && isFinite(+datum[\"amount\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "childWidth",
      "value": 110
    }
  ],
  "layout": {
    "padding": 20,
    "bounds": "full",
    "align": "each"
  },
  "marks": [
    {
      "type": "group",
      "name": "concat_0_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "childWidth"
          },
          "height": {
            "signal": "height"
          }
        }
      },
      "marks": [
        {
          "name": "concat_0_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_1"
          },
          "encode": {
            "update": {
              "fill": {
                "scale": "concat_0_color",
                "field": "category"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"category: \" + (isValid(datum[\"category\"]) ? isArray(datum[\"category\"]) ? join(datum[\"category\"], ' ') : datum[\"category\"] : \"\"+datum[\"category\"]) + \"; amount: \" + (format(datum[\"amount\"], \"\"))"
              },
              "x": {
                "scale": "concat_0_x",
                "field": "category"
              },
              "width": {
                "signal": "max(0.25, bandwidth('concat_0_x'))"
              },
              "y": {
                "scale": "concat_0_y",
                "field": "amount_end"
              },
              "y2": {
                "scale": "concat_0_y",
                "field": "amount_start"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_0_y",
          "orient": "left",
          "gridScale": "concat_0_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "grid": false,
          "title": "category",
          "labelAlign": "right",
          "labelAngle": 270,
          "labelBaseline": "middle",
          "zindex": 0
        },
        {
          "scale": "concat_0_y",
          "orient": "left",
          "grid": false,
          "title": "amount",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "zindex": 0
        }
      ],
      "legends": [
        {
          "fill": "concat_0_color",
          "symbolType": "square",
          "title": "category"
        }
      ]
    },
    {
      "type": "group",
      "name": "concat_1_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "childWidth"
          },
          "height": {
            "signal": "height"
          }
        }
      },
      "marks": [
        {
          "name": "concat_1_marks",
          "type": "symbol",
          "style": [
            "point"
          ],
          "from": {
            "data": "data_2"
          },
          "encode": {
            "update": {
              "opacity": {
                "value": 0.7
              },
              "fill": {
                "value": "transparent"
              },
              "stroke": {
                "scale": "concat_1_color",
                "field": "band"
              },
              "ariaRoleDescription": {
                "value": "point"
              },
              "description": {
                "signal": "\"score: \" + (format(datum[\"score\"], \"\")) + \"; amount: \" + (format(datum[\"amount\"], \"\")) + \"; band: \" + (isValid(datum[\"band\"]) ? isArray(datum[\"band\"]) ? join(datum[\"band\"], ' ') : datum[\"band\"] : \"\"+datum[\"band\"])"
              },
              "x": {
                "scale": "concat_1_x",
                "field": "score"
              },
              "y": {
                "scale": "concat_1_y",
                "field": "amount"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "gridScale": "concat_1_y",
          "grid": true,
          "tickCount": {
            "signal": "ceil(childWidth/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_1_y",
          "orient": "left",
          "gridScale": "concat_1_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "grid": false,
          "title": "score",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(childWidth/40)"
          },
          "zindex": 0
        },
        {
          "scale": "concat_1_y",
          "orient": "left",
          "grid": false,
          "title": "amount",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "zindex": 0
        }
      ],
      "legends": [
        {
          "stroke": "concat_1_color",
          "symbolType": "circle",
          "title": "band",
          "encode": {
            "symbols": {
              "update": {
                "fill": {
                  "value": "transparent"
                },
                "opacity": {
                  "value": 0.7
                }
              }
            }
          }
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "concat_0_x",
      "type": "band",
      "domain": {
        "data": "data_1",
        "field": "category",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "childWidth"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "concat_0_y",
      "type": "linear",
      "domain": {
        "data": "data_1",
        "fields": [
          "amount_start",
          "amount_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_0_color",
      "type": "ordinal",
      "domain": {
        "data": "data_1",
        "field": "category",
        "sort": true
      },
      "range": "category"
    },
    {
      "name": "concat_1_x",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "field": "score"
      },
      "range": [
        0,
        {
          "signal": "childWidth"
        }
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_1_y",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "field": "amount"
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_1_color",
      "type": "ordinal",
      "domain": {
        "data": "data_2",
        "field": "band",
        "sort": true
      },
      "range": "category"
    }
  ]
}
