{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A parse the specification stated over rows it wrote out, which is a formula and not the loader's work.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "height": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "when": "01 Jan 2020",
          "v": 28
        },
        {
          "when": "01 Feb 2020",
          "v": 55
        },
        {
          "when": "01 Mar 2020",
          "v": 43
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "utcParse(datum[\"when\"],'%d %b %Y')",
          "as": "when"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "line",
      "style": [
        "line"
      ],
      "sort": {
        "field": "x"
      },
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "#4c78a8"
          },
          "description": {
            "signal": "\"when: \" + (timeFormat(datum[\"when\"], \"%b %d, %Y\")) + \"; v: \" + (format(datum[\"v\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "when"
          },
          "y": {
            "scale": "y",
            "field": "v"
          },
          "defined": {
            "signal": "isValid(datum[\"when\"]) && isFinite(+datum[\"when\"]) && isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "time",
      "domain": {
        "data": "data_0",
        "field": "when"
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ]
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "v"
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "gridScale": "y",
      "grid": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "when",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "v",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ]
}
