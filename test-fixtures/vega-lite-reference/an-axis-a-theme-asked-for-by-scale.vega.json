  },
  "marks": [
    {
      "type": "group",
      "name": "concat_0_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "concat_0_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_0"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
              },
              "x": {
                "scale": "concat_0_x",
                "field": "c"
              },
              "width": {
                "signal": "max(0.25, bandwidth('concat_0_x'))"
              },
              "y": {
