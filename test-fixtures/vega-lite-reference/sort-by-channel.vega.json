{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Categories ordered by another channel's aggregate, written as the shorthand for it.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Cylinders > 3"
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Origin"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "Horsepower"
          ],
          "as": [
            "sum_Horsepower"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"sum_Horsepower\"]) && isFinite(+datum[\"sum_Horsepower\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "y_step",
      "value": 17
    },
    {
      "name": "height",
      "update": "bandspace(domain('y').length, 0.1, 0.05) * y_step"
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"power: \" + (format(datum[\"sum_Horsepower\"], \"\")) + \"; Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"])"
          },
          "x": {
            "scale": "x",
            "field": "sum_Horsepower"
          },
          "x2": {
            "scale": "x",
            "value": 0
          },
          "y": {
            "scale": "y",
            "field": "Origin"
          },
          "height": {
            "signal": "max(0.25, bandwidth('y'))"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "sum_Horsepower"
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "source_0",
        "field": "Origin",
        "sort": {
          "op": "sum",
          "field": "Horsepower",
          "order": "descending"
        }
      },
      "range": {
        "step": {
          "signal": "y_step"
        }
      },
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "gridScale": "y",
      "grid": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "power",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "Origin",
      "zindex": 0
    }
  ]
}
