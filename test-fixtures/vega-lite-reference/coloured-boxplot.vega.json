{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A coloured boxplot, whose whiskers stay black because they mark an extent.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json"
      }
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "joinaggregate",
          "as": [
            "lower_box_Horsepower",
            "upper_box_Horsepower"
          ],
          "ops": [
            "q1",
            "q3"
          ],
          "fields": [
            "Horsepower",
            "Horsepower"
          ],
          "groupby": [
            "Origin"
          ]
        }
      ]
    },
    {
      "name": "data_1",
      "source": "data_0",
      "transform": [
        {
          "type": "filter",
          "expr": "(datum['Horsepower'] < datum['lower_box_Horsepower'] - 1.5 * (datum['upper_box_Horsepower'] - datum['lower_box_Horsepower'])) || (datum['Horsepower'] > datum['upper_box_Horsepower'] + 1.5 * (datum['upper_box_Horsepower'] - datum['lower_box_Horsepower']))"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"Horsepower\"]) && isFinite(+datum[\"Horsepower\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "data_0",
      "transform": [
        {
          "type": "filter",
          "expr": "(datum['lower_box_Horsepower'] - 1.5 * (datum['upper_box_Horsepower'] - datum['lower_box_Horsepower']) <= datum['Horsepower']) && (datum['Horsepower'] <= datum['upper_box_Horsepower'] + 1.5 * (datum['upper_box_Horsepower'] - datum['lower_box_Horsepower']))"
        },
        {
          "type": "aggregate",
          "groupby": [
            "Origin"
          ],
          "ops": [
            "min",
            "max",
            "min",
            "max"
          ],
          "fields": [
            "Horsepower",
            "Horsepower",
            "lower_box_Horsepower",
            "upper_box_Horsepower"
          ],
          "as": [
            "lower_whisker_Horsepower",
            "upper_whisker_Horsepower",
            "lower_box_Horsepower",
            "upper_box_Horsepower"
          ]
        }
      ]
    },
    {
      "name": "data_3",
      "source": "data_2",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"lower_whisker_Horsepower\"]) && isFinite(+datum[\"lower_whisker_Horsepower\"])"
        }
      ]
    },
    {
      "name": "data_4",
      "source": "data_2",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"upper_box_Horsepower\"]) && isFinite(+datum[\"upper_box_Horsepower\"])"
        }
      ]
    },
    {
      "name": "data_5",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Origin"
          ],
          "ops": [
            "q1",
            "q3",
            "median",
            "min",
            "max"
          ],
          "fields": [
            "Horsepower",
            "Horsepower",
            "Horsepower",
            "Horsepower",
            "Horsepower"
          ],
          "as": [
            "lower_box_Horsepower",
            "upper_box_Horsepower",
            "mid_box_Horsepower",
            "min_Horsepower",
            "max_Horsepower"
          ]
        }
      ]
    },
    {
      "name": "data_6",
      "source": "data_5",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"lower_box_Horsepower\"]) && isFinite(+datum[\"lower_box_Horsepower\"])"
        }
      ]
    },
    {
      "name": "data_7",
      "source": "data_5",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"mid_box_Horsepower\"]) && isFinite(+datum[\"mid_box_Horsepower\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "y_step",
      "value": 20
    },
    {
      "name": "height",
      "update": "bandspace(domain('y').length, 0, 0) * y_step"
    }
  ],
  "marks": [
    {
      "name": "layer_0_layer_0_marks",
      "type": "symbol",
      "style": [
        "point",
        "boxplot-outliers"
      ],
      "from": {
        "data": "data_1"
      },
      "encode": {
        "update": {
          "opacity": {
            "value": 0.7
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "teal"
          },
          "ariaRoleDescription": {
            "value": "point"
          },
          "description": {
            "signal": "\"Horsepower: \" + (format(datum[\"Horsepower\"], \"\")) + \"; Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"])"
          },
          "x": {
            "scale": "x",
            "field": "Horsepower"
          },
          "y": {
            "scale": "y",
            "field": "Origin",
            "band": 0.5
          }
        }
      }
    },
    {
      "name": "layer_0_layer_1_layer_0_marks",
      "type": "rule",
      "style": [
        "rule",
        "boxplot-rule"
      ],
      "aria": false,
      "from": {
        "data": "data_3"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "black"
          },
          "tooltip": {
            "signal": "{\"Upper Whisker of Horsepower\": format(datum[\"upper_whisker_Horsepower\"], \"\"), \"Lower Whisker of Horsepower\": format(datum[\"lower_whisker_Horsepower\"], \"\"), \"Origin\": isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], '\\n') : datum[\"Origin\"] : \"\"+datum[\"Origin\"]}"
          },
          "x": {
            "scale": "x",
            "field": "lower_whisker_Horsepower"
          },
          "x2": {
            "scale": "x",
            "field": "lower_box_Horsepower"
          },
          "y": {
            "scale": "y",
            "field": "Origin",
            "band": 0.5
          }
        }
      }
    },
    {
      "name": "layer_0_layer_1_layer_1_marks",
      "type": "rule",
      "style": [
        "rule",
        "boxplot-rule"
      ],
      "aria": false,
      "from": {
        "data": "data_4"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "black"
          },
          "tooltip": {
            "signal": "{\"Upper Whisker of Horsepower\": format(datum[\"upper_whisker_Horsepower\"], \"\"), \"Lower Whisker of Horsepower\": format(datum[\"lower_whisker_Horsepower\"], \"\"), \"Origin\": isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], '\\n') : datum[\"Origin\"] : \"\"+datum[\"Origin\"]}"
          },
          "x": {
            "scale": "x",
            "field": "upper_box_Horsepower"
          },
          "x2": {
            "scale": "x",
            "field": "upper_whisker_Horsepower"
          },
          "y": {
            "scale": "y",
            "field": "Origin",
            "band": 0.5
          }
        }
      }
    },
    {
      "name": "layer_1_layer_0_marks",
      "type": "rect",
      "style": [
        "bar",
        "boxplot-box"
      ],
      "from": {
        "data": "data_6"
      },
      "encode": {
        "update": {
          "ariaRoleDescription": {
            "value": "box"
          },
          "fill": {
            "value": "teal"
          },
          "tooltip": {
            "signal": "{\"Max of Horsepower\": format(datum[\"max_Horsepower\"], \"\"), \"Q3 of Horsepower\": format(datum[\"upper_box_Horsepower\"], \"\"), \"Median of Horsepower\": format(datum[\"mid_box_Horsepower\"], \"\"), \"Q1 of Horsepower\": format(datum[\"lower_box_Horsepower\"], \"\"), \"Min of Horsepower\": format(datum[\"min_Horsepower\"], \"\"), \"Origin\": isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], '\\n') : datum[\"Origin\"] : \"\"+datum[\"Origin\"]}"
          },
          "description": {
            "signal": "\"Horsepower: \" + (format(datum[\"lower_box_Horsepower\"], \"\")) + \"; Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"]) + \"; upper_box_Horsepower: \" + (format(datum[\"upper_box_Horsepower\"], \"\")) + \"; Max of Horsepower: \" + (format(datum[\"max_Horsepower\"], \"\")) + \"; Q3 of Horsepower: \" + (format(datum[\"upper_box_Horsepower\"], \"\")) + \"; Median of Horsepower: \" + (format(datum[\"mid_box_Horsepower\"], \"\")) + \"; Q1 of Horsepower: \" + (format(datum[\"lower_box_Horsepower\"], \"\")) + \"; Min of Horsepower: \" + (format(datum[\"min_Horsepower\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "lower_box_Horsepower"
          },
          "x2": {
            "scale": "x",
            "field": "upper_box_Horsepower"
          },
          "yc": {
            "scale": "y",
            "field": "Origin",
            "band": 0.5
          },
          "height": {
            "value": 10
          }
        }
      }
    },
    {
      "name": "layer_1_layer_1_marks",
      "type": "rect",
      "style": [
        "tick",
        "boxplot-median"
      ],
      "aria": false,
      "from": {
        "data": "data_7"
      },
      "encode": {
        "update": {
          "opacity": {
            "value": 0.7
          },
          "fill": [
            {
              "test": "datum['lower_box_Horsepower'] >= datum['upper_box_Horsepower']",
              "value": "teal"
            },
            {
              "value": "white"
            }
          ],
          "tooltip": {
            "signal": "{\"Max of Horsepower\": format(datum[\"max_Horsepower\"], \"\"), \"Q3 of Horsepower\": format(datum[\"upper_box_Horsepower\"], \"\"), \"Median of Horsepower\": format(datum[\"mid_box_Horsepower\"], \"\"), \"Q1 of Horsepower\": format(datum[\"lower_box_Horsepower\"], \"\"), \"Min of Horsepower\": format(datum[\"min_Horsepower\"], \"\"), \"Origin\": isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], '\\n') : datum[\"Origin\"] : \"\"+datum[\"Origin\"]}"
          },
          "yc": {
            "scale": "y",
            "field": "Origin",
            "band": 0.5
          },
          "height": {
            "value": 10
          },
          "xc": {
            "scale": "x",
            "field": "mid_box_Horsepower"
          },
          "width": {
            "value": 1
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "fields": [
          {
            "data": "data_1",
            "field": "Horsepower"
          },
          {
            "data": "data_3",
            "field": "lower_whisker_Horsepower"
          },
          {
            "data": "data_3",
            "field": "lower_box_Horsepower"
          },
          {
            "data": "data_4",
            "field": "upper_box_Horsepower"
          },
          {
            "data": "data_4",
            "field": "upper_whisker_Horsepower"
          },
          {
            "data": "data_6",
            "field": "lower_box_Horsepower"
          },
          {
            "data": "data_6",
            "field": "upper_box_Horsepower"
          },
          {
            "data": "data_7",
            "field": "mid_box_Horsepower"
          }
        ]
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "zero": false,
      "nice": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "fields": [
          {
            "data": "data_1",
            "field": "Origin"
          },
          {
            "data": "data_3",
            "field": "Origin"
          },
          {
            "data": "data_4",
            "field": "Origin"
          },
          {
            "data": "data_6",
            "field": "Origin"
          },
          {
            "data": "data_7",
            "field": "Origin"
          }
        ],
        "sort": true
      },
      "range": {
        "step": {
          "signal": "y_step"
        }
      },
      "paddingInner": 0,
      "paddingOuter": 0
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "gridScale": "y",
      "grid": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "Horsepower",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "Origin",
      "zindex": 0
    }
  ]
}
