{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Two copies of one map, each colouring the same outlines by a different column. The copies are separate plots rather than a grid's cells, which is what makes it the counterpart of the trellis fixture: each copy joins the outlines on for itself, so the join must stay one per copy, and the projection must still be merged to the chart so both maps are drawn at one scale. Figures inline, as in the trellis fixture, so this stays about the composition rather than about loading.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "id": 1,
          "rate": 0.04,
          "count": 12
        },
        {
          "id": 4,
          "rate": 0.09,
          "count": 30
        },
        {
          "id": 6,
          "rate": 0.11,
          "count": 21
        },
        {
          "id": 12,
          "rate": 0.1,
          "count": 8
        }
      ]
    },
    {
      "name": "source_1",
      "url": "data/us-10m.json",
      "format": {
        "type": "topojson",
        "feature": "states"
      }
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "lookup",
          "from": "source_1",
          "key": "id",
          "fields": [
            "id"
          ],
          "as": [
            "geo"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"geo\"])"
        },
        {
          "type": "geojson",
          "geojson": "geo",
          "signal": "child__row_rate_geojson_0"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"rate\"]) && isFinite(+datum[\"rate\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "lookup",
          "from": "source_1",
          "key": "id",
          "fields": [
            "id"
          ],
          "as": [
            "geo"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"geo\"])"
        },
        {
          "type": "geojson",
          "geojson": "geo",
          "signal": "child__row_count_geojson_0"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"count\"]) && isFinite(+datum[\"count\"])"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "size": {
        "signal": "[width, childHeight]"
      },
      "fit": {
        "signal": "[child__row_rate_geojson_0, child__row_count_geojson_0]"
      },
      "type": "albersUsa"
    }
  ],
  "signals": [
    {
      "name": "childHeight",
      "value": 180
    }
  ],
  "layout": {
    "padding": 20,
    "columns": 1,
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "type": "group",
      "name": "child__row_rate_group",
      "style": "view",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "child__row_rate_marks",
          "type": "shape",
          "style": [
            "geoshape"
          ],
          "from": {
            "data": "data_1"
          },
          "encode": {
            "update": {
              "fill": {
                "scale": "child__row_rate_color",
                "field": "rate"
              },
              "ariaRoleDescription": {
                "value": "geoshape"
              },
              "description": {
                "signal": "\"rate: \" + (format(datum[\"rate\"], \"\")) + \"; geo: \" + (isValid(datum[\"geo\"]) ? datum[\"geo\"] : \"\"+datum[\"geo\"])"
              }
            }
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "projection",
              "field": "datum[\"geo\"]"
            }
          ]
        }
      ],
      "legends": [
        {
          "fill": "child__row_rate_color",
          "gradientLength": {
            "signal": "clamp(childHeight, 64, 200)"
          },
          "title": "rate"
        }
      ]
    },
    {
      "type": "group",
      "name": "child__row_count_group",
      "style": "view",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "child__row_count_marks",
          "type": "shape",
          "style": [
            "geoshape"
          ],
          "from": {
            "data": "data_2"
          },
          "encode": {
            "update": {
              "fill": {
                "scale": "child__row_count_color",
                "field": "count"
              },
              "ariaRoleDescription": {
                "value": "geoshape"
              },
              "description": {
                "signal": "\"count: \" + (format(datum[\"count\"], \"\")) + \"; geo: \" + (isValid(datum[\"geo\"]) ? datum[\"geo\"] : \"\"+datum[\"geo\"])"
              }
            }
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "projection",
              "field": "datum[\"geo\"]"
            }
          ]
        }
      ],
      "legends": [
        {
          "fill": "child__row_count_color",
          "gradientLength": {
            "signal": "clamp(childHeight, 64, 200)"
          },
          "title": "count"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "child__row_rate_color",
      "type": "linear",
      "domain": {
        "data": "data_1",
        "field": "rate"
      },
      "range": "heatmap",
      "interpolate": "hcl",
      "zero": false
    },
    {
      "name": "child__row_count_color",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "field": "count"
      },
      "range": "heatmap",
      "interpolate": "hcl",
      "zero": false
    }
  ]
}
