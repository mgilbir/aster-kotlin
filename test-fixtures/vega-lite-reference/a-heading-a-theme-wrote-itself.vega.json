{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A trellis heading a **theme** writes. `assembleLabelTitle` asks `getHeaderProperties(['format', 'formatType', 'labelAngle', 'labelAnchor', 'labelOrient', 'labelExpr'], facetFieldDef.header, config, channel)` — all six through the same chain, the channel's own header block and then the theme — and then substitutes `datum.label` with what it would otherwise have written and `datum.value` with the column itself. This compiler read `labelExpr` from the header block alone, so a `config.header.labelExpr` was dropped and a theme that captions every cell of every trellis the same way captioned none of them. The **column** headings here come from the theme; the **row** headings state their own, which must win over it. Both facets live in one chart rather than two beside each other, and deliberately: a concatenation emits its facet domain datasets in an order this compiler and upstream disagree about, which is a difference of its own and would fail this fixture for a reason that has nothing to do with headings.",
  "background": "white",
  "padding": 5,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "k": "one",
          "j": "up",
          "g": "x",
          "v": 28
        },
        {
          "k": "two",
          "j": "down",
          "g": "y",
          "v": 55
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "g",
            "j",
            "k"
          ],
          "field": "v",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "v_start",
            "v_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    },
    {
      "name": "column_domain",
      "source": "data_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "k"
          ]
        }
      ]
    },
    {
      "name": "row_domain",
      "source": "data_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "j"
          ]
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "child_width",
      "value": 70
    },
    {
      "name": "child_height",
      "value": 50
    }
  ],
  "layout": {
    "padding": 20,
    "offset": {
      "rowTitle": 10,
      "columnTitle": 10
    },
    "columns": {
      "signal": "length(data('column_domain'))"
    },
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "name": "row-title",
      "type": "group",
      "role": "row-title",
      "title": {
        "text": "j",
        "orient": "left",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "column-title",
      "type": "group",
      "role": "column-title",
      "title": {
        "text": "k",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "row_header",
      "type": "group",
      "role": "row-header",
      "from": {
        "data": "row_domain"
      },
      "sort": {
        "field": "datum[\"j\"]",
        "order": "ascending"
      },
      "title": {
        "text": {
          "signal": "'<' + isValid(parent[\"j\"]) ? parent[\"j\"] : \"\"+parent[\"j\"] + '>'"
        },
        "orient": "left",
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {
        "update": {
          "height": {
            "signal": "child_height"
          }
        }
      },
      "axes": [
        {
          "scale": "y",
          "orient": "left",
          "grid": false,
          "title": "v",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(child_height/40)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "name": "column_header",
      "type": "group",
      "role": "column-header",
      "from": {
        "data": "column_domain"
      },
      "sort": {
        "field": "datum[\"k\"]",
        "order": "ascending"
      },
      "title": {
        "text": {
          "signal": "isValid(parent[\"k\"]) ? parent[\"k\"] : \"\"+parent[\"k\"] + ' ▸'"
        },
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          }
        }
      }
    },
    {
      "name": "column_footer",
      "type": "group",
      "role": "column-footer",
      "from": {
        "data": "column_domain"
      },
      "sort": {
        "field": "datum[\"k\"]",
        "order": "ascending"
      },
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          }
        }
      },
      "axes": [
        {
          "scale": "x",
          "orient": "bottom",
          "grid": false,
          "title": "g",
          "labelAlign": "right",
          "labelAngle": 270,
          "labelBaseline": "middle",
          "zindex": 0
        }
      ]
    },
    {
      "name": "cell",
      "type": "group",
      "style": "cell",
      "from": {
        "facet": {
          "name": "facet",
          "data": "data_0",
          "groupby": [
            "j",
            "k"
          ],
          "aggregate": {
            "cross": true
          }
        }
      },
      "sort": {
        "field": [
          "datum[\"j\"]",
          "datum[\"k\"]"
        ],
        "order": [
          "ascending",
          "ascending"
        ]
      },
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          },
          "height": {
            "signal": "child_height"
          }
        }
      },
      "marks": [
        {
          "name": "child_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "facet"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"g: \" + (isValid(datum[\"g\"]) ? isArray(datum[\"g\"]) ? join(datum[\"g\"], ' ') : datum[\"g\"] : \"\"+datum[\"g\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
              },
              "x": {
                "scale": "x",
                "field": "g"
              },
              "width": {
                "signal": "max(0.25, bandwidth('x'))"
              },
              "y": {
                "scale": "y",
                "field": "v_end"
              },
              "y2": {
                "scale": "y",
                "field": "v_start"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "y",
          "orient": "left",
          "gridScale": "x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(child_height/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "data_0",
        "field": "g",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "child_width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": [
          "v_start",
          "v_end"
        ]
      },
      "range": [
        {
          "signal": "child_height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ]
}
