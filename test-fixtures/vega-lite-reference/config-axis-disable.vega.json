{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A chart made of shapes rather than of measurements: the theme turns every axis off at once, and its own padding beats the configured one.",
  "background": "white",
  "padding": 50,
  "width": 300,
  "height": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "x": 0.25,
          "y": 0.433
        },
        {
          "x": 0.75,
          "y": 0.433
        },
        {
          "x": 0.5,
          "y": 0
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "toNumber(datum[\"x\"])",
          "as": "x"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "line",
      "style": [
        "line"
      ],
      "sort": {
        "field": "x"
      },
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "#76d9e4"
          },
          "description": {
            "signal": "\"x: \" + (format(datum[\"x\"], \"\")) + \"; y: \" + (format(datum[\"y\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "x"
          },
          "y": {
            "scale": "y",
            "field": "y"
          },
          "defined": {
            "signal": "isValid(datum[\"x\"]) && isFinite(+datum[\"x\"]) && isValid(datum[\"y\"]) && isFinite(+datum[\"y\"])"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "x"
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "nice": true,
      "zero": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "y"
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "config": {
    "axis": {
      "disable": true,
      "grid": false
    },
    "style": {
      "cell": {
        "stroke": "transparent"
      }
    }
  }
}
