{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The two ends of `getMarkConfig`'s chain that `a-size-a-theme-asked-for` cannot reach, because a size found early stops the walk. The first row is the **style block**, which upstream puts ahead of everything else — `getFirstDefined(vgChannel ? cfg : undefined, cfg, config[mark.type][vgChannel], …)`, with `cfg` the style config — so `config.style.bar.size` of 13 wins over `config.bar.width` of 5 even though the latter is written under Vega's own name for the property. A mark's styles are its type followed by whatever its `style` names. The second row is the far end: `minBandSize` configured as **zero**, which is a floor of nothing and therefore no floor at all, upstream's test being `minBandSize ? max(…) : bandWidth`. It has to be a `rect` rather than a bar because a size found anywhere earlier in the chain would settle the width before the band is ever measured, and the bar above has one.",
  "background": "white",
  "padding": 5,
  "width": 200,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "c": "alpha",
          "v": 28
        },
        {
          "c": "beta",
          "v": 55
        },
        {
          "c": "gamma",
          "v": 43
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "c"
          ],
          "field": "v",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "v_start",
            "v_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "childHeight",
      "value": 60
    }
  ],
  "layout": {
    "padding": 20,
    "columns": 1,
    "bounds": "full",
    "align": "each"
  },
  "marks": [
    {
      "type": "group",
      "name": "concat_0_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "concat_0_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_1"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
              },
              "xc": {
                "scale": "concat_0_x",
                "field": "c",
                "band": 0.5
              },
              "width": {
                "value": 13
              },
              "y": {
                "scale": "concat_0_y",
                "field": "v_end"
              },
              "y2": {
                "scale": "concat_0_y",
                "field": "v_start"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_0_y",
          "orient": "left",
          "gridScale": "concat_0_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "grid": false,
          "title": "c",
          "labelAlign": "right",
          "labelAngle": 270,
          "labelBaseline": "middle",
          "zindex": 0
        },
        {
          "scale": "concat_0_y",
          "orient": "left",
          "grid": false,
          "title": "v",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "type": "group",
      "name": "concat_1_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "concat_1_marks",
          "type": "rect",
          "style": [
            "rect"
          ],
          "from": {
            "data": "data_2"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "description": {
                "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
              },
              "x": {
                "scale": "concat_1_x",
                "field": "c"
              },
              "width": {
                "signal": "bandwidth('concat_1_x')"
              },
              "y": {
                "scale": "concat_1_y",
                "field": "v"
              },
              "y2": {
                "scale": "concat_1_y",
                "value": 0
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_1_y",
          "orient": "left",
          "gridScale": "concat_1_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "grid": false,
          "title": "c",
          "labelAlign": "right",
          "labelAngle": 270,
          "labelBaseline": "middle",
          "zindex": 1
        },
        {
          "scale": "concat_1_y",
          "orient": "left",
          "grid": false,
          "title": "v",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "concat_0_x",
      "type": "band",
      "domain": {
        "data": "data_1",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "concat_0_y",
      "type": "linear",
      "domain": {
        "data": "data_1",
        "fields": [
          "v_start",
          "v_end"
        ]
      },
      "range": [
        {
          "signal": "childHeight"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_1_x",
      "type": "band",
      "domain": {
        "data": "data_2",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0,
      "paddingOuter": 0
    },
    {
      "name": "concat_1_y",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "field": "v"
      },
      "range": [
        {
          "signal": "childHeight"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "config": {
    "style": {
      "bar": {
        "width": 5,
        "size": 13
      }
    }
  }
}
