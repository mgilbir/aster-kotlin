{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A mark property and a label angle computed by parameters, and a turn written negatively.",
  "background": "white",
  "padding": 5,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json"
      },
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Origin",
            "Cylinders"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "x_step",
      "value": 20
    },
    {
      "name": "width",
      "update": "bandspace(domain('x').length, 0, 0) * x_step"
    },
    {
      "name": "y_step",
      "value": 20
    },
    {
      "name": "height",
      "update": "bandspace(domain('y').length, 0, 0) * y_step"
    },
    {
      "name": "cornerRadius",
      "value": 4,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 20
      }
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "rect"
      ],
      "from": {
        "data": "source_0"
      },
      "encode": {
        "update": {
          "cornerRadius": {
            "signal": "cornerRadius"
          },
          "fill": {
            "scale": "color",
            "field": "__count"
          },
          "description": {
            "signal": "\"Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"]) + \"; Cylinders: \" + (isValid(datum[\"Cylinders\"]) ? isArray(datum[\"Cylinders\"]) ? join(datum[\"Cylinders\"], ' ') : datum[\"Cylinders\"] : \"\"+datum[\"Cylinders\"]) + \"; Count of Records: \" + (format(datum[\"__count\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "Origin"
          },
          "width": {
            "signal": "max(0.25, bandwidth('x'))"
          },
          "y": {
            "scale": "y",
            "field": "Cylinders"
          },
          "height": {
            "signal": "max(0.25, bandwidth('y'))"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "source_0",
        "field": "Origin",
        "sort": true
      },
      "range": {
        "step": {
          "signal": "x_step"
        }
      },
      "paddingInner": 0,
      "paddingOuter": 0
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "source_0",
        "field": "Cylinders",
        "sort": true
      },
      "range": {
        "step": {
          "signal": "y_step"
        }
      },
      "paddingInner": 0,
      "paddingOuter": 0
    },
    {
      "name": "color",
      "type": "linear",
      "domain": {
        "data": "source_0",
        "field": "__count"
      },
      "range": "heatmap",
      "interpolate": "hcl",
      "zero": false
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "Origin",
      "labelAngle": 315,
      "labelAlign": "right",
      "labelBaseline": "top",
      "zindex": 1
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "Cylinders",
      "zindex": 1
    }
  ],
  "legends": [
    {
      "fill": "color",
      "gradientLength": {
        "signal": "clamp(height, 64, 200)"
      },
      "title": "Count of Records"
    }
  ]
}
