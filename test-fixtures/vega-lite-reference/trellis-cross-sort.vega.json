{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A grid crossed both ways, each direction ordered by an aggregate of its own.",
  "background": "white",
  "padding": 5,
  "data": [
    {
      "name": "source_0",
      "url": "data/barley.json",
      "format": {
        "type": "json"
      },
      "transform": [
        {
          "type": "joinaggregate",
          "as": [
            "median_yield_by_site"
          ],
          "ops": [
            "median"
          ],
          "fields": [
            "yield"
          ],
          "groupby": [
            "site"
          ]
        },
        {
          "type": "joinaggregate",
          "as": [
            "mean_yield_by_year"
          ],
          "ops": [
            "mean"
          ],
          "fields": [
            "yield"
          ],
          "groupby": [
            "year"
          ]
        },
        {
          "type": "aggregate",
          "groupby": [
            "variety",
            "site",
            "year"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "yield"
          ],
          "as": [
            "sum_yield"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"sum_yield\"]) && isFinite(+datum[\"sum_yield\"])"
        }
      ]
    },
    {
      "name": "column_domain",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "year"
          ],
          "fields": [
            "yield"
          ],
          "ops": [
            "mean"
          ],
          "as": [
            "mean_yield"
          ]
        }
      ]
    },
    {
      "name": "row_domain",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "site"
          ],
          "fields": [
            "yield"
          ],
          "ops": [
            "median"
          ],
          "as": [
            "median_yield"
          ]
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "child_width",
      "value": 300
    },
    {
      "name": "y_step",
      "value": 20
    },
    {
      "name": "child_height",
      "update": "bandspace(domain('y').length, 1, 0.5) * y_step"
    }
  ],
  "layout": {
    "padding": 20,
    "offset": {
      "rowTitle": 10,
      "columnTitle": 10
    },
    "columns": {
      "signal": "length(data('column_domain'))"
    },
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "name": "row-title",
      "type": "group",
      "role": "row-title",
      "title": {
        "text": "site",
        "orient": "left",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "column-title",
      "type": "group",
      "role": "column-title",
      "title": {
        "text": "year",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "row_header",
      "type": "group",
      "role": "row-header",
      "from": {
        "data": "row_domain"
      },
      "sort": {
        "field": "datum[\"median_yield\"]",
        "order": "ascending"
      },
      "title": {
        "text": {
          "signal": "isValid(parent[\"site\"]) ? parent[\"site\"] : \"\"+parent[\"site\"]"
        },
        "orient": "left",
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {
        "update": {
          "height": {
            "signal": "child_height"
          }
        }
      },
      "axes": [
        {
          "scale": "y",
          "orient": "left",
          "grid": false,
          "title": "variety",
          "zindex": 0
        }
      ]
    },
    {
      "name": "column_header",
      "type": "group",
      "role": "column-header",
      "from": {
        "data": "column_domain"
      },
      "sort": {
        "field": "datum[\"mean_yield\"]",
        "order": "ascending"
      },
      "title": {
        "text": {
          "signal": "isValid(parent[\"year\"]) ? parent[\"year\"] : \"\"+parent[\"year\"]"
        },
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          }
        }
      }
    },
    {
      "name": "column_footer",
      "type": "group",
      "role": "column-footer",
      "from": {
        "data": "column_domain"
      },
      "sort": {
        "field": "datum[\"mean_yield\"]",
        "order": "ascending"
      },
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          }
        }
      },
      "axes": [
        {
          "scale": "x",
          "orient": "bottom",
          "grid": false,
          "title": "Sum of yield",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(child_width/40)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "name": "cell",
      "type": "group",
      "style": "cell",
      "from": {
        "facet": {
          "name": "facet",
          "data": "source_0",
          "groupby": [
            "site",
            "year"
          ],
          "aggregate": {
            "cross": true,
            "fields": [
              "median_yield_by_site",
              "mean_yield_by_year"
            ],
            "ops": [
              "max",
              "max"
            ],
            "as": [
              "median_yield_by_site",
              "mean_yield_by_year"
            ]
          }
        }
      },
      "sort": {
        "field": [
          "datum[\"median_yield_by_site\"]",
          "datum[\"mean_yield_by_year\"]"
        ],
        "order": [
          "ascending",
          "ascending"
        ]
      },
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          },
          "height": {
            "signal": "child_height"
          }
        }
      },
      "marks": [
        {
          "name": "child_marks",
          "type": "symbol",
          "style": [
            "point"
          ],
          "from": {
            "data": "facet"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "transparent"
              },
              "stroke": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "point"
              },
              "description": {
                "signal": "\"Sum of yield: \" + (format(datum[\"sum_yield\"], \"\")) + \"; variety: \" + (isValid(datum[\"variety\"]) ? isArray(datum[\"variety\"]) ? join(datum[\"variety\"], ' ') : datum[\"variety\"] : \"\"+datum[\"variety\"])"
              },
              "x": {
                "scale": "x",
                "field": "sum_yield"
              },
              "y": {
                "scale": "y",
                "field": "variety"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "x",
          "orient": "bottom",
          "gridScale": "y",
          "grid": true,
          "tickCount": {
            "signal": "ceil(child_width/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "source_0",
        "field": "sum_yield"
      },
      "range": [
        0,
        {
          "signal": "child_width"
        }
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "y",
      "type": "point",
      "domain": {
        "data": "source_0",
        "field": "variety",
        "sort": true
      },
      "range": {
        "step": {
          "signal": "y_step"
        }
      },
      "padding": 0.5
    }
  ]
}
