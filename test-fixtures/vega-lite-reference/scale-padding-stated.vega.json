{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A band that states its inner padding, and a discretizing size scale that does not start at zero.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json"
      },
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Origin",
            "Acceleration"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        },
        {
          "type": "stack",
          "groupby": [
            "Origin"
          ],
          "field": "__count",
          "sort": {
            "field": [
              "Acceleration"
            ],
            "order": [
              "ascending"
            ]
          },
          "as": [
            "__count_start",
            "__count_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"Acceleration\"]) && isFinite(+datum[\"Acceleration\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "y_step",
      "value": 20
    },
    {
      "name": "height",
      "update": "bandspace(domain('y').length, 0.25, 0.125) * y_step"
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "source_0"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "black"
          },
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"Count of Records: \" + (format(datum[\"__count\"], \"\")) + \"; Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"]) + \"; Acceleration: \" + (format(datum[\"Acceleration\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "__count_end"
          },
          "x2": {
            "scale": "x",
            "field": "__count_start"
          },
          "yc": {
            "scale": "y",
            "field": "Origin",
            "band": 0.5
          },
          "height": {
            "scale": "size",
            "field": "Acceleration"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "source_0",
        "fields": [
          "__count_start",
          "__count_end"
        ]
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "source_0",
        "field": "Origin",
        "sort": true
      },
      "range": {
        "step": {
          "signal": "y_step"
        }
      },
      "paddingInner": 0.25,
      "paddingOuter": 0.125
    },
    {
      "name": "size",
      "type": "quantize",
      "domain": {
        "data": "source_0",
        "field": "Acceleration"
      },
      "range": {
        "signal": "sequence(2, 19 + (19 - 2) / (4 - 1), (19 - 2) / (4 - 1))"
      },
      "zero": false
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "gridScale": "y",
      "grid": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "Count of Records",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "Origin",
      "zindex": 0
    }
  ],
  "legends": [
    {
      "size": "size",
      "symbolType": "square",
      "title": "Acceleration",
      "encode": {
        "symbols": {
          "update": {
            "strokeWidth": {
              "value": 2
            },
            "fill": {
              "value": "#4c78a8"
            },
            "stroke": {
              "value": "black"
            }
          }
        }
      }
    }
  ],
  "config": {
    "style": {
      "bar": {
        "strokeWidth": 2
      }
    }
  }
}
