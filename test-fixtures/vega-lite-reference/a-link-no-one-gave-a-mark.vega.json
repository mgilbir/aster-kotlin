{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The other half of `a-link-a-theme-gave-every-mark`, which cannot be a row beside it because a configuration is chart-level: a chart with no link anywhere — no `href` channel, none on the mark, none in the theme — draws no `cursor` at all. `cursor` returns `markDef.cursor`, which is nothing, and the property is never written. A rule that reached for the pointer on the strength of the theme alone would put one on every chart that has a `config.mark` block of any kind, which is most of them.",
  "background": "white",
  "padding": 5,
  "width": 180,
  "height": 60,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "c": "alpha",
          "v": 28
        },
        {
          "c": "beta",
          "v": 55
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "c"
          ],
          "field": "v",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "v_start",
            "v_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "c"
          },
          "width": {
            "signal": "max(0.25, bandwidth('x'))"
          },
          "y": {
            "scale": "y",
            "field": "v_end"
          },
          "y2": {
            "scale": "y",
            "field": "v_start"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "data_0",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": [
          "v_start",
          "v_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "c",
      "labelAlign": "right",
      "labelAngle": 270,
      "labelBaseline": "middle",
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "v",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ],
  "config": {
    "mark": {
      "opacity": 0.9
    }
  }
}
