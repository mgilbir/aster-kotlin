{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A tick pinned to a constant position along one axis and banded along the other.",
  "background": "white",
  "padding": 5,
  "height": 20,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json"
      }
    }
  ],
  "signals": [
    {
      "name": "x_step",
      "value": 20
    },
    {
      "name": "width",
      "update": "bandspace(domain('x').length, 0.25, 0.125) * x_step"
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "tick"
      ],
      "from": {
        "data": "source_0"
      },
      "encode": {
        "update": {
          "opacity": {
            "value": 0.7
          },
          "fill": {
            "value": "#ccc"
          },
          "ariaRoleDescription": {
            "value": "tick"
          },
          "description": {
            "signal": "\"Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"])"
          },
          "y": {
            "value": 30
          },
          "y2": {
            "field": {
              "group": "height"
            }
          },
          "xc": {
            "scale": "x",
            "field": "Origin",
            "band": 0.5
          },
          "width": {
            "value": 1
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "source_0",
        "field": "Origin",
        "sort": true
      },
      "range": {
        "step": {
          "signal": "x_step"
        }
      },
      "paddingInner": 0.25,
      "paddingOuter": 0.125
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "Origin",
      "labelAlign": "right",
      "labelAngle": 270,
      "labelBaseline": "middle",
      "zindex": 0
    }
  ]
}
