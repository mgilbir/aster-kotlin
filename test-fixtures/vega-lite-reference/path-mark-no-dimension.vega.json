{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A line with only one position channel, and that channel not the one its orientation makes its dimension. `getSort` asks whether the dimension channel is a *field* before ordering the points by it: there is an order to draw them in only where the dimension is a column. This compiler ordered by the channel name regardless, so Vega was handed `sort: {\"field\": \"y\"}` for items with no `y` — every item comparing equal, a sort that does nothing at some cost. Found by probing a layer of such a mark, and it has nothing to do with layers.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "height": 20,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "x": 1,
          "y": 2
        },
        {
          "x": 3,
          "y": 4
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "line",
      "style": [
        "line"
      ],
      "from": {
        "data": "source_0"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "#4c78a8"
          },
          "description": {
            "signal": "\"y: \" + (format(datum[\"y\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "y"
          },
          "y": {
            "signal": "height",
            "mult": 0.5
          },
          "defined": {
            "signal": "isValid(datum[\"y\"]) && isFinite(+datum[\"y\"])"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "source_0",
        "field": "y"
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "grid": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "y",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "zindex": 0
    }
  ]
}
