{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A rect-like mark stating its own `align` or `baseline` over a band it would otherwise start at. Upstream chooses the Vega channel first — `left` is `x`, `center` is `xc`, `right` is `x2`, and the same three down the other axis — and only then asks whether that channel is a centre: `const center = vgChannel === 'xc' || vgChannel === 'yc'`. A centred one is placed at the band's middle, `band: 0.5`, where a mark left to fill its band is placed at the leading edge with no band at all. This engine read the *default* alignment instead of the resulting channel, so a bar that asked to be centred was written under `xc` — the channel that means the middle — with its position still at the edge. The three rows here state `center`, the default, and `right`, so the channel and the band are both drawn.",
  "background": "white",
  "padding": 5,
  "width": 200,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "c": "alpha",
          "v": 28
        },
        {
          "c": "beta",
          "v": 55
        },
        {
          "c": "gamma",
          "v": 43
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "c"
          ],
          "field": "v",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "v_start",
            "v_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "childHeight",
      "value": 40
    }
  ],
  "layout": {
    "padding": 20,
    "columns": 1,
    "bounds": "full",
    "align": "each"
  },
  "marks": [
    {
      "type": "group",
      "name": "concat_0_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "concat_0_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_1"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
              },
              "xc": {
                "scale": "concat_0_x",
                "field": "c",
                "band": 0.5
              },
              "width": {
                "value": 12
              },
              "y": {
                "scale": "concat_0_y",
                "field": "v_end"
              },
              "y2": {
                "scale": "concat_0_y",
                "field": "v_start"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_0_y",
          "orient": "left",
          "gridScale": "concat_0_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "grid": false,
          "title": "c",
          "labelAlign": "right",
          "labelAngle": 270,
          "labelBaseline": "middle",
          "zindex": 0
        },
        {
          "scale": "concat_0_y",
          "orient": "left",
          "grid": false,
          "title": "v",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "type": "group",
      "name": "concat_1_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "concat_1_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_1"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
              },
              "x2": {
                "scale": "concat_1_x",
                "field": "c"
              },
              "width": {
                "value": 12
              },
              "y": {
                "scale": "concat_1_y",
                "field": "v_end"
              },
              "y2": {
                "scale": "concat_1_y",
                "field": "v_start"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_1_y",
          "orient": "left",
          "gridScale": "concat_1_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "grid": false,
          "title": "c",
          "labelAlign": "right",
          "labelAngle": 270,
          "labelBaseline": "middle",
          "zindex": 0
        },
        {
          "scale": "concat_1_y",
          "orient": "left",
          "grid": false,
          "title": "v",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(childHeight/40)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "type": "group",
      "name": "concat_2_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "childHeight"
          }
        }
      },
      "marks": [
        {
          "name": "concat_2_marks",
          "type": "rect",
          "style": [
            "tick"
          ],
          "from": {
            "data": "data_2"
          },
          "encode": {
            "update": {
              "opacity": {
                "value": 0.7
              },
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "tick"
              },
              "description": {
                "signal": "\"v: \" + (format(datum[\"v\"], \"\")) + \"; c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"])"
              },
              "yc": {
                "scale": "concat_2_y",
                "field": "c",
                "band": 0.5
              },
              "height": {
                "signal": "max(0.25, bandwidth('concat_2_y'))"
              },
              "xc": {
                "scale": "concat_2_x",
                "field": "v"
              },
              "width": {
                "value": 1
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_2_x",
          "orient": "bottom",
          "gridScale": "concat_2_y",
          "grid": true,
          "tickCount": {
            "signal": "ceil(width/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_2_x",
          "orient": "bottom",
          "grid": false,
          "title": "v",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(width/40)"
          },
          "zindex": 0
        },
        {
          "scale": "concat_2_y",
          "orient": "left",
          "grid": false,
          "title": "c",
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "concat_0_x",
      "type": "band",
      "domain": {
        "data": "data_1",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "concat_0_y",
      "type": "linear",
      "domain": {
        "data": "data_1",
        "fields": [
          "v_start",
          "v_end"
        ]
      },
      "range": [
        {
          "signal": "childHeight"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_1_x",
      "type": "band",
      "domain": {
        "data": "data_1",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "concat_1_y",
      "type": "linear",
      "domain": {
        "data": "data_1",
        "fields": [
          "v_start",
          "v_end"
        ]
      },
      "range": [
        {
          "signal": "childHeight"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_2_x",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "field": "v"
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_2_y",
      "type": "band",
      "domain": {
        "data": "data_2",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "childHeight"
        }
      ],
      "paddingInner": 0.25,
      "paddingOuter": 0.125
    }
  ]
}
