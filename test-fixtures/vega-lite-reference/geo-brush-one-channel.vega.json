{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The same brush over a map, dragged along latitude only, and it is not the two-channel case with a channel removed. The rectangle spans the plot across, so the brush is a band over the map rather than a line; and the two stated latitudes have no longitude to be projected with, so they borrow the place the middle of the plot inverts back to — which is the whole reason `projection_center` exists. The aggregate below it is the second rule this fixture carries: an aggregate's rows are not the rows that went in, so a selection remembering rows by identity writes the identity again beneath it, and a circle without one could not be picked at all.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "height": 200,
  "style": "view",
  "data": [
    {
      "name": "brush_store",
      "transform": [
        {
          "type": "collect",
          "sort": {
            "field": "_vgsid_"
          }
        }
      ],
      "values": [
        {
          "unit": "",
          "_vgsid_": [
            35,
            42
          ]
        }
      ]
    },
    {
      "name": "source_0",
      "values": [
        {
          "port": "a",
          "lon": -122.4,
          "lat": 37.8
        },
        {
          "port": "a",
          "lon": -122.4,
          "lat": 37.8
        },
        {
          "port": "b",
          "lon": -87.6,
          "lat": 41.9
        },
        {
          "port": "c",
          "lon": -74,
          "lat": 40.7
        },
        {
          "port": "d",
          "lon": -95.4,
          "lat": 29.8
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "identifier",
          "as": "_vgsid_"
        },
        {
          "type": "aggregate",
          "groupby": [
            "port",
            "lon",
            "lat"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "flights"
          ]
        },
        {
          "type": "identifier",
          "as": "_vgsid_"
        },
        {
          "type": "geojson",
          "fields": [
            "lon",
            "lat"
          ],
          "signal": "geojson_0"
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"flights\"]) && isFinite(+datum[\"flights\"])"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "size": {
        "signal": "[width, height]"
      },
      "fit": {
        "signal": "geojson_0"
      },
      "type": "albersUsa"
    }
  ],
  "signals": [
    {
      "name": "unit",
      "value": {},
      "on": [
        {
          "events": "pointermove",
          "update": "isTuple(group()) ? group() : unit"
        }
      ]
    },
    {
      "name": "geo_interval_init_tick",
      "value": null,
      "on": [
        {
          "events": "timer{1}",
          "update": "geo_interval_init_tick === null ? {} : geo_interval_init_tick"
        }
      ]
    },
    {
      "name": "brush",
      "update": "vlSelectionResolve(\"brush_store\", \"union\")"
    },
    {
      "name": "projection_center",
      "update": "invert(\"projection\", [width/2, height/2])"
    },
    {
      "name": "brush_init",
      "init": "[scale(\"projection\", [projection_center[0], 35]), scale(\"projection\", [projection_center[0], 42])]"
    },
    {
      "name": "brush_latitude",
      "init": "[brush_init[0][1], brush_init[1][1]]",
      "on": [
        {
          "events": {
            "source": "scope",
            "type": "pointerdown",
            "filter": [
              "!event.item || event.item.mark.name !== \"brush_brush\""
            ]
          },
          "update": "[y(unit), y(unit)]"
        },
        {
          "events": {
            "source": "window",
            "type": "pointermove",
            "consume": true,
            "between": [
              {
                "source": "scope",
                "type": "pointerdown",
                "filter": [
                  "!event.item || event.item.mark.name !== \"brush_brush\""
                ]
              },
              {
                "source": "window",
                "type": "pointerup"
              }
            ]
          },
          "update": "[brush_latitude[0], clamp(y(unit), 0, height)]"
        },
        {
          "events": [
            {
              "source": "view",
              "type": "dblclick"
            }
          ],
          "update": "[0, 0]"
        },
        {
          "events": {
            "signal": "brush_translate_delta"
          },
          "update": "clampRange(panLinear(brush_translate_anchor.extent_y, brush_translate_delta.y / span(brush_translate_anchor.extent_y)), 0, height)"
        },
        {
          "events": {
            "signal": "brush_zoom_delta"
          },
          "update": "clampRange(zoomLinear(brush_latitude, brush_zoom_anchor.y, brush_zoom_delta), 0, height)"
        }
      ]
    },
    {
      "name": "brush_tuple",
      "on": [
        {
          "events": [
            {
              "signal": "brush_latitude"
            },
            {
              "signal": "geo_interval_init_tick"
            }
          ],
          "update": "vlSelectionTuples(intersect([[0, brush_latitude[0]],[width, brush_latitude[1]]], {markname: \"marks\"}, unit.mark), {unit: \"\"})"
        }
      ]
    },
    {
      "name": "brush_translate_anchor",
      "value": {},
      "on": [
        {
          "events": [
            {
              "source": "scope",
              "type": "pointerdown",
              "markname": "brush_brush"
            }
          ],
          "update": "{x: x(unit), y: y(unit), extent_y: slice(brush_latitude)}"
        }
      ]
    },
    {
      "name": "brush_translate_delta",
      "value": {},
      "on": [
        {
          "events": [
            {
              "source": "window",
              "type": "pointermove",
              "consume": true,
              "between": [
                {
                  "source": "scope",
                  "type": "pointerdown",
                  "markname": "brush_brush"
                },
                {
                  "source": "window",
                  "type": "pointerup"
                }
              ]
            }
          ],
          "update": "{x: brush_translate_anchor.x - x(unit), y: brush_translate_anchor.y - y(unit)}"
        }
      ]
    },
    {
      "name": "brush_zoom_anchor",
      "on": [
        {
          "events": [
            {
              "source": "scope",
              "type": "wheel",
              "consume": true,
              "markname": "brush_brush"
            }
          ],
          "update": "{x: x(unit), y: y(unit)}"
        }
      ]
    },
    {
      "name": "brush_zoom_delta",
      "on": [
        {
          "events": [
            {
              "source": "scope",
              "type": "wheel",
              "consume": true,
              "markname": "brush_brush"
            }
          ],
          "force": true,
          "update": "pow(1.001, event.deltaY * pow(16, event.deltaMode))"
        }
      ]
    },
    {
      "name": "brush_modify",
      "on": [
        {
          "events": {
            "signal": "brush_tuple"
          },
          "update": "modify(\"brush_store\", brush_tuple, true)"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "brush_brush_bg",
      "type": "rect",
      "clip": true,
      "encode": {
        "enter": {
          "fill": {
            "value": "#333"
          },
          "fillOpacity": {
            "value": 0.125
          }
        },
        "update": {
          "x": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "value": 0
            },
            {
              "value": 0
            }
          ],
          "y": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "signal": "brush_latitude[0]"
            },
            {
              "value": 0
            }
          ],
          "x2": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "field": {
                "group": "width"
              }
            },
            {
              "value": 0
            }
          ],
          "y2": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "signal": "brush_latitude[1]"
            },
            {
              "value": 0
            }
          ]
        }
      }
    },
    {
      "name": "marks",
      "type": "symbol",
      "style": [
        "circle"
      ],
      "interactive": true,
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "opacity": {
            "value": 0.7
          },
          "fill": [
            {
              "test": "length(data(\"brush_store\")) && vlSelectionIdTest(\"brush_store\", datum)",
              "value": "goldenrod"
            },
            {
              "value": "steelblue"
            }
          ],
          "ariaRoleDescription": {
            "value": "circle"
          },
          "description": {
            "signal": "\"lon: \" + (format(datum[\"lon\"], \"\")) + \"; lat: \" + (format(datum[\"lat\"], \"\")) + \"; flights: \" + (format(datum[\"flights\"], \"\"))"
          },
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "scale": "size",
            "field": "flights"
          },
          "shape": {
            "value": "circle"
          }
        }
      }
    },
    {
      "name": "brush_brush",
      "type": "rect",
      "clip": true,
      "encode": {
        "enter": {
          "cursor": {
            "value": "move"
          },
          "fill": {
            "value": "transparent"
          }
        },
        "update": {
          "x": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "value": 0
            },
            {
              "value": 0
            }
          ],
          "y": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "signal": "brush_latitude[0]"
            },
            {
              "value": 0
            }
          ],
          "x2": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "field": {
                "group": "width"
              }
            },
            {
              "value": 0
            }
          ],
          "y2": [
            {
              "test": "data(\"brush_store\").length && data(\"brush_store\")[0].unit === \"\"",
              "signal": "brush_latitude[1]"
            },
            {
              "value": 0
            }
          ],
          "stroke": [
            {
              "test": "brush_latitude[0] !== brush_latitude[1]",
              "value": "white"
            },
            {
              "value": null
            }
          ]
        }
      }
    }
  ],
  "scales": [
    {
      "name": "size",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "flights"
      },
      "range": [
        4,
        361
      ],
      "zero": true
    }
  ],
  "legends": [
    {
      "size": "size",
      "symbolType": "circle",
      "title": "flights",
      "encode": {
        "symbols": {
          "update": {
            "fill": {
              "value": "steelblue"
            },
            "opacity": {
              "value": 0.7
            },
            "stroke": {
              "value": "transparent"
            }
          }
        }
      }
    }
  ]
}
