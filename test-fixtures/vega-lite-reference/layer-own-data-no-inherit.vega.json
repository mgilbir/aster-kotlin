{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A layer reading its own table runs none of the chart's transforms: it is not below them.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "height": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_1",
      "values": [
        {
          "year": 1960
        },
        {
          "year": 1980
        },
        {
          "year": 2000
        }
      ]
    },
    {
      "name": "source_0",
      "url": "data/driving.json",
      "format": {
        "type": "json"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "+datum.year + 5",
          "as": "year_end"
        },
        {
          "type": "stack",
          "groupby": [
            "year",
            "year"
          ],
          "field": "miles",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "miles_start",
            "miles_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"year\"]) && isFinite(+datum[\"year\"]) && isValid(datum[\"miles\"]) && isFinite(+datum[\"miles\"])"
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_1",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"year\"]) && isFinite(+datum[\"year\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "layer_0_marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "source_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"year: \" + (!isValid(datum[\"year\"]) || !isFinite(+datum[\"year\"]) ? \"null\" : format(datum[\"year\"], \"\") + \" – \" + format(datum[\"year_end\"], \"\")) + \"; miles: \" + (format(datum[\"miles\"], \"\"))"
          },
          "x2": {
            "scale": "x",
            "field": "year",
            "offset": {
              "signal": "0.5 + (abs(scale(\"x\", datum[\"year_end\"]) - scale(\"x\", datum[\"year\"])) < 0.25 ? -0.5 * (0.25 - (abs(scale(\"x\", datum[\"year_end\"]) - scale(\"x\", datum[\"year\"])))) : 0.5)"
            }
          },
          "x": {
            "scale": "x",
            "field": "year_end",
            "offset": {
              "signal": "0.5 + (abs(scale(\"x\", datum[\"year_end\"]) - scale(\"x\", datum[\"year\"])) < 0.25 ? 0.5 * (0.25 - (abs(scale(\"x\", datum[\"year_end\"]) - scale(\"x\", datum[\"year\"])))) : -0.5)"
            }
          },
          "y": {
            "scale": "y",
            "field": "miles_end"
          },
          "y2": {
            "scale": "y",
            "field": "miles_start"
          }
        }
      }
    },
    {
      "name": "layer_1_marks",
      "type": "rule",
      "style": [
        "rule"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "black"
          },
          "description": {
            "signal": "\"year: \" + (format(datum[\"year\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "year"
          },
          "y": {
            "scale": "y",
            "field": "year"
          },
          "y2": {
            "scale": "y",
            "value": 0
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "fields": [
          {
            "data": "source_0",
            "field": "year"
          },
          {
            "data": "source_0",
            "field": "year_end"
          },
          {
            "data": "data_0",
            "field": "year"
          }
        ]
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "nice": true,
      "zero": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "fields": [
          {
            "data": "source_0",
            "field": "miles_start"
          },
          {
            "data": "source_0",
            "field": "miles_end"
          },
          {
            "data": "data_0",
            "field": "year"
          }
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "year, year_end, year",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(width/40)"
      },
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "miles, year",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ]
}
