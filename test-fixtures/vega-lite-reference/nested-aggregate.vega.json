{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A column named through a path, aggregated — where the name is referenced and so escaped.",
  "background": "white",
  "padding": 5,
  "height": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "properties": {
            "yield": 12,
            "site": "a"
          }
        },
        {
          "properties": {
            "yield": 23,
            "site": "a"
          }
        },
        {
          "properties": {
            "yield": 47,
            "site": "b"
          }
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "formula",
          "expr": "datum[\"properties\"] && datum[\"properties\"][\"site\"]",
          "as": "properties.site"
        },
        {
          "type": "joinaggregate",
          "as": [
            "average"
          ],
          "ops": [
            "mean"
          ],
          "fields": [
            "properties.yield"
          ],
          "groupby": [
            "properties.site"
          ]
        },
        {
          "type": "stack",
          "groupby": [
            "properties\\.site"
          ],
          "field": "average",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "average_start",
            "average_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"average\"]) && isFinite(+datum[\"average\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "x_step",
      "value": 20
    },
    {
      "name": "width",
      "update": "bandspace(domain('x').length, 0.1, 0.05) * x_step"
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"properties.site: \" + (isValid(datum[\"properties.site\"]) ? isArray(datum[\"properties.site\"]) ? join(datum[\"properties.site\"], ' ') : datum[\"properties.site\"] : \"\"+datum[\"properties.site\"]) + \"; average: \" + (format(datum[\"average\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "properties\\.site"
          },
          "width": {
            "signal": "max(0.25, bandwidth('x'))"
          },
          "y": {
            "scale": "y",
            "field": "average_end"
          },
          "y2": {
            "scale": "y",
            "field": "average_start"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "data_0",
        "field": "properties\\.site",
        "sort": true
      },
      "range": {
        "step": {
          "signal": "x_step"
        }
      },
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": [
          "average_start",
          "average_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "properties.site",
      "labelAlign": "right",
      "labelAngle": 270,
      "labelBaseline": "middle",
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "average",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ]
}
