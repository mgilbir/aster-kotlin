{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A binned histogram split by a row, so the bin and the facet share one flow.",
  "background": "white",
  "padding": 5,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "g": "A",
          "v": 1
        },
        {
          "g": "A",
          "v": 2
        },
        {
          "g": "A",
          "v": 8
        },
        {
          "g": "A",
          "v": 9
        },
        {
          "g": "B",
          "v": 3
        },
        {
          "g": "B",
          "v": 4
        },
        {
          "g": "B",
          "v": 4
        },
        {
          "g": "B",
          "v": 10
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "extent",
          "field": "v",
          "signal": "child_bin_maxbins_5_v_extent"
        },
        {
          "type": "bin",
          "field": "v",
          "as": [
            "bin_maxbins_5_v",
            "bin_maxbins_5_v_end"
          ],
          "signal": "child_bin_maxbins_5_v_bins",
          "extent": {
            "signal": "child_bin_maxbins_5_v_extent"
          },
          "maxbins": 5
        },
        {
          "type": "aggregate",
          "groupby": [
            "bin_maxbins_5_v",
            "bin_maxbins_5_v_end",
            "g"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"bin_maxbins_5_v\"]) && isFinite(+datum[\"bin_maxbins_5_v\"])"
        }
      ]
    },
    {
      "name": "row_domain",
      "source": "data_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "g"
          ]
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "child_width",
      "value": 300
    },
    {
      "name": "child_height",
      "value": 300
    }
  ],
  "layout": {
    "padding": 20,
    "offset": {
      "rowTitle": 10
    },
    "columns": 1,
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "name": "row-title",
      "type": "group",
      "role": "row-title",
      "title": {
        "text": "g",
        "orient": "left",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "row_header",
      "type": "group",
      "role": "row-header",
      "from": {
        "data": "row_domain"
      },
      "sort": {
        "field": "datum[\"g\"]",
        "order": "ascending"
      },
      "title": {
        "text": {
          "signal": "isValid(parent[\"g\"]) ? parent[\"g\"] : \"\"+parent[\"g\"]"
        },
        "orient": "left",
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      },
      "encode": {
        "update": {
          "height": {
            "signal": "child_height"
          }
        }
      },
      "axes": [
        {
          "scale": "y",
          "orient": "left",
          "grid": false,
          "title": "Count of Records",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(child_height/40)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "name": "column_footer",
      "type": "group",
      "role": "column-footer",
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          }
        }
      },
      "axes": [
        {
          "scale": "x",
          "orient": "bottom",
          "grid": false,
          "title": "v (binned)",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(child_width/10)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "name": "cell",
      "type": "group",
      "style": "cell",
      "from": {
        "facet": {
          "name": "facet",
          "data": "data_0",
          "groupby": [
            "g"
          ]
        }
      },
      "sort": {
        "field": [
          "datum[\"g\"]"
        ],
        "order": [
          "ascending"
        ]
      },
      "encode": {
        "update": {
          "width": {
            "signal": "child_width"
          },
          "height": {
            "signal": "child_height"
          }
        }
      },
      "marks": [
        {
          "name": "child_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "facet"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"v (binned): \" + (!isValid(datum[\"bin_maxbins_5_v\"]) || !isFinite(+datum[\"bin_maxbins_5_v\"]) ? \"null\" : format(datum[\"bin_maxbins_5_v\"], \"\") + \" – \" + format(datum[\"bin_maxbins_5_v_end\"], \"\")) + \"; Count of Records: \" + (format(datum[\"__count\"], \"\"))"
              },
              "x2": {
                "scale": "x",
                "field": "bin_maxbins_5_v",
                "offset": {
                  "signal": "0.5 + (abs(scale(\"x\", datum[\"bin_maxbins_5_v_end\"]) - scale(\"x\", datum[\"bin_maxbins_5_v\"])) < 0.25 ? -0.5 * (0.25 - (abs(scale(\"x\", datum[\"bin_maxbins_5_v_end\"]) - scale(\"x\", datum[\"bin_maxbins_5_v\"])))) : 0.5)"
                }
              },
              "x": {
                "scale": "x",
                "field": "bin_maxbins_5_v_end",
                "offset": {
                  "signal": "0.5 + (abs(scale(\"x\", datum[\"bin_maxbins_5_v_end\"]) - scale(\"x\", datum[\"bin_maxbins_5_v\"])) < 0.25 ? 0.5 * (0.25 - (abs(scale(\"x\", datum[\"bin_maxbins_5_v_end\"]) - scale(\"x\", datum[\"bin_maxbins_5_v\"])))) : -0.5)"
                }
              },
              "y": {
                "scale": "y",
                "field": "__count"
              },
              "y2": {
                "scale": "y",
                "value": 0
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "y",
          "orient": "left",
          "gridScale": "x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(child_height/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "signal": "[child_bin_maxbins_5_v_bins.start, child_bin_maxbins_5_v_bins.stop]"
      },
      "range": [
        0,
        {
          "signal": "child_width"
        }
      ],
      "bins": {
        "signal": "child_bin_maxbins_5_v_bins"
      },
      "zero": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "__count"
      },
      "range": [
        {
          "signal": "child_height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ]
}
