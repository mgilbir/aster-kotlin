        {
          "type": "stack",
          "groupby": [
            "t"
          ],
          "field": "v",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "v_start",
            "v_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "(isDate(datum[\"t\"]) || (isValid(datum[\"t\"]) && isFinite(+datum[\"t\"]))) && isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    },
