  "padding": 5,
  "width": 110,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "a": -10,
          "b": null
        },
        {
          "a": -5,
          "b": -25
        },
        {
          "a": -1,
          "b": -20
        },
        {
          "a": 0,
          "b": null
        },
        {
