{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A `resolve` written on one plot of a concatenation governs the layers inside that plot.",
  "background": "white",
  "padding": 5,
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json"
      }
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "extent",
          "field": "Horsepower",
          "signal": "concat_0_layer_1_bin_maxbins_10_Horsepower_extent"
        },
        {
          "type": "bin",
          "field": "Horsepower",
          "as": [
            "bin_maxbins_10_Horsepower",
            "bin_maxbins_10_Horsepower_end"
          ],
          "signal": "concat_0_layer_1_bin_maxbins_10_Horsepower_bins",
          "extent": {
            "signal": "concat_0_layer_1_bin_maxbins_10_Horsepower_extent"
          },
          "maxbins": 10
        },
        {
          "type": "extent",
          "field": "Miles_per_Gallon",
          "signal": "concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_extent"
        },
        {
          "type": "bin",
          "field": "Miles_per_Gallon",
          "as": [
            "bin_maxbins_10_Miles_per_Gallon",
            "bin_maxbins_10_Miles_per_Gallon_end"
          ],
          "signal": "concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_bins",
          "extent": {
            "signal": "concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_extent"
          },
          "maxbins": 10
        }
      ]
    },
    {
      "name": "data_1",
      "source": "data_0",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.Origin === 'Japan'"
        },
        {
          "type": "aggregate",
          "groupby": [
            "bin_maxbins_10_Horsepower",
            "bin_maxbins_10_Horsepower_end",
            "bin_maxbins_10_Miles_per_Gallon",
            "bin_maxbins_10_Miles_per_Gallon_end"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"bin_maxbins_10_Horsepower\"]) && isFinite(+datum[\"bin_maxbins_10_Horsepower\"]) && isValid(datum[\"bin_maxbins_10_Miles_per_Gallon\"]) && isFinite(+datum[\"bin_maxbins_10_Miles_per_Gallon\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "data_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "bin_maxbins_10_Horsepower",
            "bin_maxbins_10_Horsepower_end",
            "bin_maxbins_10_Miles_per_Gallon",
            "bin_maxbins_10_Miles_per_Gallon_end"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"bin_maxbins_10_Horsepower\"]) && isFinite(+datum[\"bin_maxbins_10_Horsepower\"]) && isValid(datum[\"bin_maxbins_10_Miles_per_Gallon\"]) && isFinite(+datum[\"bin_maxbins_10_Miles_per_Gallon\"])"
        }
      ]
    },
    {
      "name": "data_3",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "Origin"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "concat_0_width",
      "value": 300
    },
    {
      "name": "concat_0_height",
      "value": 300
    },
    {
      "name": "concat_1_width",
      "value": 330
    },
    {
      "name": "concat_1_height",
      "value": 120
    }
  ],
  "layout": {
    "padding": 20,
    "columns": 1,
    "bounds": "full",
    "align": "each"
  },
  "marks": [
    {
      "type": "group",
      "name": "concat_0_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "concat_0_width"
          },
          "height": {
            "signal": "concat_0_height"
          }
        }
      },
      "marks": [
        {
          "name": "concat_0_layer_0_marks",
          "type": "symbol",
          "style": [
            "circle"
          ],
          "from": {
            "data": "data_2"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "opacity": {
                "value": 0.4
              },
              "ariaRoleDescription": {
                "value": "circle"
              },
              "description": {
                "signal": "\"Horsepower (binned): \" + (!isValid(datum[\"bin_maxbins_10_Horsepower\"]) || !isFinite(+datum[\"bin_maxbins_10_Horsepower\"]) ? \"null\" : format(datum[\"bin_maxbins_10_Horsepower\"], \"\") + \" – \" + format(datum[\"bin_maxbins_10_Horsepower_end\"], \"\")) + \"; Miles_per_Gallon (binned): \" + (!isValid(datum[\"bin_maxbins_10_Miles_per_Gallon\"]) || !isFinite(+datum[\"bin_maxbins_10_Miles_per_Gallon\"]) ? \"null\" : format(datum[\"bin_maxbins_10_Miles_per_Gallon\"], \"\") + \" – \" + format(datum[\"bin_maxbins_10_Miles_per_Gallon_end\"], \"\")) + \"; All Cars Count: \" + (format(datum[\"__count\"], \"\"))"
              },
              "x": {
                "signal": "scale(\"concat_0_x\", 0.5 * datum[\"bin_maxbins_10_Horsepower\"] + 0.5 * datum[\"bin_maxbins_10_Horsepower_end\"])"
              },
              "y": {
                "signal": "scale(\"concat_0_y\", 0.5 * datum[\"bin_maxbins_10_Miles_per_Gallon\"] + 0.5 * datum[\"bin_maxbins_10_Miles_per_Gallon_end\"])"
              },
              "size": {
                "scale": "size",
                "field": "__count"
              },
              "shape": {
                "value": "circle"
              }
            }
          }
        },
        {
          "name": "concat_0_layer_1_marks",
          "type": "symbol",
          "style": [
            "circle"
          ],
          "from": {
            "data": "data_1"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "circle"
              },
              "description": {
                "signal": "\"Horsepower (binned): \" + (!isValid(datum[\"bin_maxbins_10_Horsepower\"]) || !isFinite(+datum[\"bin_maxbins_10_Horsepower\"]) ? \"null\" : format(datum[\"bin_maxbins_10_Horsepower\"], \"\") + \" – \" + format(datum[\"bin_maxbins_10_Horsepower_end\"], \"\")) + \"; Miles_per_Gallon (binned): \" + (!isValid(datum[\"bin_maxbins_10_Miles_per_Gallon\"]) || !isFinite(+datum[\"bin_maxbins_10_Miles_per_Gallon\"]) ? \"null\" : format(datum[\"bin_maxbins_10_Miles_per_Gallon\"], \"\") + \" – \" + format(datum[\"bin_maxbins_10_Miles_per_Gallon_end\"], \"\")) + \"; Cars from Japan Count: \" + (format(datum[\"__count\"], \"\"))"
              },
              "x": {
                "signal": "scale(\"concat_0_x\", 0.5 * datum[\"bin_maxbins_10_Horsepower\"] + 0.5 * datum[\"bin_maxbins_10_Horsepower_end\"])"
              },
              "y": {
                "signal": "scale(\"concat_0_y\", 0.5 * datum[\"bin_maxbins_10_Miles_per_Gallon\"] + 0.5 * datum[\"bin_maxbins_10_Miles_per_Gallon_end\"])"
              },
              "size": {
                "scale": "size",
                "field": "__count"
              },
              "shape": {
                "value": "circle"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "grid": false,
          "title": "Horsepower (binned)",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(concat_0_width/10)"
          },
          "zindex": 0
        },
        {
          "scale": "concat_0_y",
          "orient": "left",
          "grid": false,
          "title": "Miles_per_Gallon (binned)",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(concat_0_height/10)"
          },
          "zindex": 0
        }
      ],
      "legends": [
        {
          "title": "All Cars Count",
          "size": "size",
          "symbolType": "circle",
          "encode": {
            "symbols": {
              "update": {
                "fill": {
                  "value": "#4c78a8"
                },
                "opacity": {
                  "value": 0.4
                },
                "stroke": {
                  "value": "transparent"
                }
              }
            }
          }
        },
        {
          "title": "Cars from Japan Count",
          "size": "size",
          "symbolType": "circle",
          "encode": {
            "symbols": {
              "update": {
                "fill": {
                  "value": "#4c78a8"
                },
                "stroke": {
                  "value": "transparent"
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "concat_1_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "concat_1_width"
          },
          "height": {
            "signal": "concat_1_height"
          }
        }
      },
      "marks": [
        {
          "name": "concat_1_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_3"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"Count of Records: \" + (format(datum[\"__count\"], \"\")) + \"; Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"])"
              },
              "x": {
                "scale": "concat_1_x",
                "field": "__count"
              },
              "x2": {
                "scale": "concat_1_x",
                "value": 0
              },
              "y": {
                "scale": "concat_1_y",
                "field": "Origin"
              },
              "height": {
                "signal": "max(0.25, bandwidth('concat_1_y'))"
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "gridScale": "concat_1_y",
          "grid": true,
          "tickCount": {
            "signal": "ceil(concat_1_width/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "grid": false,
          "title": "Count of Records",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(concat_1_width/40)"
          },
          "zindex": 0
        },
        {
          "scale": "concat_1_y",
          "orient": "left",
          "grid": false,
          "title": "Origin",
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "size",
      "type": "linear",
      "domain": {
        "fields": [
          {
            "data": "data_2",
            "field": "__count"
          },
          {
            "data": "data_1",
            "field": "__count"
          }
        ]
      },
      "range": [
        4,
        {
          "signal": "pow(0.95 * min(concat_0_width / ((concat_0_layer_1_bin_maxbins_10_Horsepower_bins.stop - concat_0_layer_1_bin_maxbins_10_Horsepower_bins.start) / concat_0_layer_1_bin_maxbins_10_Horsepower_bins.step), concat_0_height / ((concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_bins.stop - concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_bins.start) / concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_bins.step)), 2)"
        }
      ],
      "zero": true
    },
    {
      "name": "concat_0_x",
      "type": "linear",
      "domain": {
        "signal": "[concat_0_layer_1_bin_maxbins_10_Horsepower_bins.start, concat_0_layer_1_bin_maxbins_10_Horsepower_bins.stop]"
      },
      "range": [
        0,
        {
          "signal": "concat_0_width"
        }
      ],
      "bins": {
        "signal": "concat_0_layer_1_bin_maxbins_10_Horsepower_bins"
      },
      "zero": false
    },
    {
      "name": "concat_0_y",
      "type": "linear",
      "domain": {
        "signal": "[concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_bins.start, concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_bins.stop]"
      },
      "range": [
        {
          "signal": "concat_0_height"
        },
        0
      ],
      "bins": {
        "signal": "concat_0_layer_1_bin_maxbins_10_Miles_per_Gallon_bins"
      },
      "zero": false
    },
    {
      "name": "concat_1_x",
      "type": "linear",
      "domain": {
        "data": "data_3",
        "field": "__count"
      },
      "range": [
        0,
        {
          "signal": "concat_1_width"
        }
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_1_y",
      "type": "band",
      "domain": {
        "data": "data_3",
        "field": "Origin",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "concat_1_height"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    }
  ]
}
