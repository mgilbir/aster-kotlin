{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A gridline picked out at zero by a condition, and an extent published as a parameter.",
  "background": "white",
  "padding": 5,
  "width": 180,
  "height": 110,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "a": "A",
          "b": 28
        },
        {
          "a": "B",
          "b": -19
        },
        {
          "a": "C",
          "b": 43
        },
        {
          "a": "D",
          "b": -31
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "extent",
          "field": "b",
          "signal": "b_extent"
        },
        {
          "type": "stack",
          "groupby": [
            "a"
          ],
          "field": "b",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "b_start",
            "b_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"b\"]) && isFinite(+datum[\"b\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"a: \" + (isValid(datum[\"a\"]) ? isArray(datum[\"a\"]) ? join(datum[\"a\"], ' ') : datum[\"a\"] : \"\"+datum[\"a\"]) + \"; b: \" + (format(datum[\"b\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "a"
          },
          "width": {
            "signal": "max(0.25, bandwidth('x'))"
          },
          "y": {
            "scale": "y",
            "field": "b_end"
          },
          "y2": {
            "scale": "y",
            "field": "b_start"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "data_0",
        "field": "a",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": [
          "b_start",
          "b_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "encode": {
        "grid": {
          "update": {
            "stroke": [
              {
                "test": "datum.value === 0",
                "value": "black"
              },
              {
                "value": "#ddd"
              }
            ]
          }
        }
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "a",
      "labelAlign": "right",
      "labelAngle": 270,
      "labelBaseline": "middle",
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "b",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ]
}
