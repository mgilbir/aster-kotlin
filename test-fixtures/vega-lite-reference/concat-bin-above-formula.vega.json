{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Two histograms, one of a computed column: the bucketings that can climb above the formula do.",
  "background": "white",
  "padding": 5,
  "height": 300,
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json"
      },
      "transform": [
        {
          "type": "extent",
          "field": "Acceleration",
          "signal": "concat_0_bin_maxbins_20_Acceleration_extent"
        },
        {
          "type": "bin",
          "field": "Acceleration",
          "as": [
            "bin_maxbins_20_Acceleration",
            "bin_maxbins_20_Acceleration_end"
          ],
          "signal": "concat_0_bin_maxbins_20_Acceleration_bins",
          "extent": {
            "signal": "concat_0_bin_maxbins_20_Acceleration_extent"
          },
          "maxbins": 20
        },
        {
          "type": "formula",
          "expr": "datum.Horsepower / datum.Weight_in_lbs",
          "as": "power"
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "extent",
          "field": "power",
          "signal": "concat_1_bin_maxbins_20_power_extent"
        },
        {
          "type": "bin",
          "field": "power",
          "as": [
            "bin_maxbins_20_power",
            "bin_maxbins_20_power_end"
          ],
          "signal": "concat_1_bin_maxbins_20_power_bins",
          "extent": {
            "signal": "concat_1_bin_maxbins_20_power_extent"
          },
          "maxbins": 20
        },
        {
          "type": "aggregate",
          "groupby": [
            "bin_maxbins_20_power",
            "bin_maxbins_20_power_end"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"bin_maxbins_20_power\"]) && isFinite(+datum[\"bin_maxbins_20_power\"])"
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "bin_maxbins_20_Acceleration",
            "bin_maxbins_20_Acceleration_end"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"bin_maxbins_20_Acceleration\"]) && isFinite(+datum[\"bin_maxbins_20_Acceleration\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "childWidth",
      "value": 300
    }
  ],
  "layout": {
    "padding": 20,
    "bounds": "full",
    "align": "each"
  },
  "marks": [
    {
      "type": "group",
      "name": "concat_0_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "childWidth"
          },
          "height": {
            "signal": "height"
          }
        }
      },
      "marks": [
        {
          "name": "concat_0_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_1"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"Acceleration (binned): \" + (!isValid(datum[\"bin_maxbins_20_Acceleration\"]) || !isFinite(+datum[\"bin_maxbins_20_Acceleration\"]) ? \"null\" : format(datum[\"bin_maxbins_20_Acceleration\"], \"\") + \" – \" + format(datum[\"bin_maxbins_20_Acceleration_end\"], \"\")) + \"; Count of Records: \" + (format(datum[\"__count\"], \"\"))"
              },
              "x2": {
                "scale": "concat_0_x",
                "field": "bin_maxbins_20_Acceleration",
                "offset": {
                  "signal": "0.5 + (abs(scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration_end\"]) - scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration\"])) < 0.25 ? -0.5 * (0.25 - (abs(scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration_end\"]) - scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration\"])))) : 0.5)"
                }
              },
              "x": {
                "scale": "concat_0_x",
                "field": "bin_maxbins_20_Acceleration_end",
                "offset": {
                  "signal": "0.5 + (abs(scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration_end\"]) - scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration\"])) < 0.25 ? 0.5 * (0.25 - (abs(scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration_end\"]) - scale(\"concat_0_x\", datum[\"bin_maxbins_20_Acceleration\"])))) : -0.5)"
                }
              },
              "y": {
                "scale": "concat_0_y",
                "field": "__count"
              },
              "y2": {
                "scale": "concat_0_y",
                "value": 0
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_0_y",
          "orient": "left",
          "gridScale": "concat_0_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_0_x",
          "orient": "bottom",
          "grid": false,
          "title": "Acceleration (binned)",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(childWidth/10)"
          },
          "zindex": 0
        },
        {
          "scale": "concat_0_y",
          "orient": "left",
          "grid": false,
          "title": "Count of Records",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "zindex": 0
        }
      ]
    },
    {
      "type": "group",
      "name": "concat_1_group",
      "style": "cell",
      "encode": {
        "update": {
          "width": {
            "signal": "childWidth"
          },
          "height": {
            "signal": "height"
          }
        }
      },
      "marks": [
        {
          "name": "concat_1_marks",
          "type": "rect",
          "style": [
            "bar"
          ],
          "from": {
            "data": "data_0"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#4c78a8"
              },
              "ariaRoleDescription": {
                "value": "bar"
              },
              "description": {
                "signal": "\"power (binned): \" + (!isValid(datum[\"bin_maxbins_20_power\"]) || !isFinite(+datum[\"bin_maxbins_20_power\"]) ? \"null\" : format(datum[\"bin_maxbins_20_power\"], \"\") + \" – \" + format(datum[\"bin_maxbins_20_power_end\"], \"\")) + \"; Count of Records: \" + (format(datum[\"__count\"], \"\"))"
              },
              "x2": {
                "scale": "concat_1_x",
                "field": "bin_maxbins_20_power",
                "offset": {
                  "signal": "0.5 + (abs(scale(\"concat_1_x\", datum[\"bin_maxbins_20_power_end\"]) - scale(\"concat_1_x\", datum[\"bin_maxbins_20_power\"])) < 0.25 ? -0.5 * (0.25 - (abs(scale(\"concat_1_x\", datum[\"bin_maxbins_20_power_end\"]) - scale(\"concat_1_x\", datum[\"bin_maxbins_20_power\"])))) : 0.5)"
                }
              },
              "x": {
                "scale": "concat_1_x",
                "field": "bin_maxbins_20_power_end",
                "offset": {
                  "signal": "0.5 + (abs(scale(\"concat_1_x\", datum[\"bin_maxbins_20_power_end\"]) - scale(\"concat_1_x\", datum[\"bin_maxbins_20_power\"])) < 0.25 ? 0.5 * (0.25 - (abs(scale(\"concat_1_x\", datum[\"bin_maxbins_20_power_end\"]) - scale(\"concat_1_x\", datum[\"bin_maxbins_20_power\"])))) : -0.5)"
                }
              },
              "y": {
                "scale": "concat_1_y",
                "field": "__count"
              },
              "y2": {
                "scale": "concat_1_y",
                "value": 0
              }
            }
          }
        }
      ],
      "axes": [
        {
          "scale": "concat_1_y",
          "orient": "left",
          "gridScale": "concat_1_x",
          "grid": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "domain": false,
          "labels": false,
          "aria": false,
          "maxExtent": 0,
          "minExtent": 0,
          "ticks": false,
          "zindex": 0
        },
        {
          "scale": "concat_1_x",
          "orient": "bottom",
          "grid": false,
          "title": "power (binned)",
          "labelFlush": true,
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(childWidth/10)"
          },
          "zindex": 0
        },
        {
          "scale": "concat_1_y",
          "orient": "left",
          "grid": false,
          "title": "Count of Records",
          "labelOverlap": true,
          "tickCount": {
            "signal": "ceil(height/40)"
          },
          "zindex": 0
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "concat_0_x",
      "type": "linear",
      "domain": {
        "signal": "[concat_0_bin_maxbins_20_Acceleration_bins.start, concat_0_bin_maxbins_20_Acceleration_bins.stop]"
      },
      "range": [
        0,
        {
          "signal": "childWidth"
        }
      ],
      "bins": {
        "signal": "concat_0_bin_maxbins_20_Acceleration_bins"
      },
      "zero": false
    },
    {
      "name": "concat_0_y",
      "type": "linear",
      "domain": {
        "data": "data_1",
        "field": "__count"
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "concat_1_x",
      "type": "linear",
      "domain": {
        "signal": "[concat_1_bin_maxbins_20_power_bins.start, concat_1_bin_maxbins_20_power_bins.stop]"
      },
      "range": [
        0,
        {
          "signal": "childWidth"
        }
      ],
      "bins": {
        "signal": "concat_1_bin_maxbins_20_power_bins"
      },
      "zero": false
    },
    {
      "name": "concat_1_y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "__count"
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ]
}
