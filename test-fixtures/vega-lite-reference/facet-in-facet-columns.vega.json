{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The same nesting by column, which is a different rule from the same nesting by row. Rows stack however many there are; columns have to be counted, and a grid inside a cell has to be counted *per cell* — so the outer partition aggregates a `distinct_size` and the cell reads it back as the number of columns it is wide. The inner layout then states no column count of its own: the chart's own count would be every cell's columns at once. Upstream's note points at vega/vega#952.",
  "background": "white",
  "padding": 5,
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "region": "north",
          "size": "big",
          "x": 1,
          "y": 4
        },
        {
          "region": "north",
          "size": "small",
          "x": 2,
          "y": 3
        },
        {
          "region": "south",
          "size": "big",
          "x": 3,
          "y": 2
        },
        {
          "region": "south",
          "size": "small",
          "x": 4,
          "y": 1
        }
      ]
    },
    {
      "name": "column_domain",
      "source": "source_0",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "region"
          ]
        }
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"x\"]) && isFinite(+datum[\"x\"]) && isValid(datum[\"y\"]) && isFinite(+datum[\"y\"])"
        }
      ]
    }
  ],
  "signals": [
    {
      "name": "child_child_width",
      "value": 120
    },
    {
      "name": "child_child_height",
      "value": 80
    }
  ],
  "layout": {
    "padding": 20,
    "headerBand": {
      "column": 0.5
    },
    "offset": {
      "columnTitle": 10
    },
    "columns": {
      "signal": "length(data('column_domain'))"
    },
    "bounds": "full",
    "align": "all"
  },
  "marks": [
    {
      "name": "column-title",
      "type": "group",
      "role": "column-title",
      "title": {
        "text": "region / size",
        "style": "guide-title",
        "offset": 10
      }
    },
    {
      "name": "column_header",
      "type": "group",
      "role": "column-header",
      "from": {
        "data": "column_domain"
      },
      "sort": {
        "field": "datum[\"region\"]",
        "order": "ascending"
      },
      "title": {
        "text": {
          "signal": "isValid(parent[\"region\"]) ? parent[\"region\"] : \"\"+parent[\"region\"]"
        },
        "style": "guide-label",
        "frame": "group",
        "offset": 10
      }
    },
    {
      "name": "cell",
      "type": "group",
      "from": {
        "facet": {
          "name": "facet",
          "data": "source_0",
          "groupby": [
            "region"
          ],
          "aggregate": {
            "fields": [
              "size"
            ],
            "ops": [
              "distinct"
            ],
            "as": [
              "distinct_size"
            ]
          }
        }
      },
      "sort": {
        "field": [
          "datum[\"region\"]"
        ],
        "order": [
          "ascending"
        ]
      },
      "data": [
        {
          "name": "child_column_domain",
          "source": "facet",
          "transform": [
            {
              "type": "aggregate",
              "groupby": [
                "size"
              ]
            }
          ]
        }
      ],
      "encode": {
        "update": {
          "columns": {
            "field": "distinct_size"
          }
        }
      },
      "layout": {
        "padding": 20,
        "bounds": "full",
        "align": "all"
      },
      "marks": [
        {
          "name": "child_row_header",
          "type": "group",
          "role": "row-header",
          "encode": {
            "update": {
              "height": {
                "signal": "child_child_height"
              }
            }
          },
          "axes": [
            {
              "scale": "y",
              "orient": "left",
              "grid": false,
              "title": "y",
              "labelOverlap": true,
              "tickCount": {
                "signal": "ceil(child_child_height/40)"
              },
              "zindex": 0
            }
          ]
        },
        {
          "name": "child_column_header",
          "type": "group",
          "role": "column-header",
          "from": {
            "data": "child_column_domain"
          },
          "sort": {
            "field": "datum[\"size\"]",
            "order": "ascending"
          },
          "title": {
            "text": {
              "signal": "isValid(parent[\"size\"]) ? parent[\"size\"] : \"\"+parent[\"size\"]"
            },
            "style": "guide-label",
            "frame": "group",
            "offset": 10
          },
          "encode": {
            "update": {
              "width": {
                "signal": "child_child_width"
              }
            }
          }
        },
        {
          "name": "child_column_footer",
          "type": "group",
          "role": "column-footer",
          "from": {
            "data": "child_column_domain"
          },
          "sort": {
            "field": "datum[\"size\"]",
            "order": "ascending"
          },
          "encode": {
            "update": {
              "width": {
                "signal": "child_child_width"
              }
            }
          },
          "axes": [
            {
              "scale": "x",
              "orient": "bottom",
              "grid": false,
              "title": "x",
              "labelFlush": true,
              "labelOverlap": true,
              "tickCount": {
                "signal": "ceil(child_child_width/40)"
              },
              "zindex": 0
            }
          ]
        },
        {
          "name": "child_cell",
          "type": "group",
          "style": "cell",
          "from": {
            "facet": {
              "name": "child_facet",
              "data": "facet",
              "groupby": [
                "size"
              ]
            }
          },
          "sort": {
            "field": [
              "datum[\"size\"]"
            ],
            "order": [
              "ascending"
            ]
          },
          "data": [
            {
              "source": "child_facet",
              "name": "data_0",
              "transform": [
                {
                  "type": "filter",
                  "expr": "isValid(datum[\"x\"]) && isFinite(+datum[\"x\"]) && isValid(datum[\"y\"]) && isFinite(+datum[\"y\"])"
                }
              ]
            }
          ],
          "encode": {
            "update": {
              "width": {
                "signal": "child_child_width"
              },
              "height": {
                "signal": "child_child_height"
              }
            }
          },
          "marks": [
            {
              "name": "child_child_marks",
              "type": "symbol",
              "style": [
                "point"
              ],
              "from": {
                "data": "data_0"
              },
              "encode": {
                "update": {
                  "opacity": {
                    "value": 0.7
                  },
                  "fill": {
                    "value": "transparent"
                  },
                  "stroke": {
                    "value": "#4c78a8"
                  },
                  "ariaRoleDescription": {
                    "value": "point"
                  },
                  "description": {
                    "signal": "\"x: \" + (format(datum[\"x\"], \"\")) + \"; y: \" + (format(datum[\"y\"], \"\"))"
                  },
                  "x": {
                    "scale": "x",
                    "field": "x"
                  },
                  "y": {
                    "scale": "y",
                    "field": "y"
                  }
                }
              }
            }
          ],
          "axes": [
            {
              "scale": "x",
              "orient": "bottom",
              "gridScale": "y",
              "grid": true,
              "tickCount": {
                "signal": "ceil(child_child_width/40)"
              },
              "domain": false,
              "labels": false,
              "aria": false,
              "maxExtent": 0,
              "minExtent": 0,
              "ticks": false,
              "zindex": 0
            },
            {
              "scale": "y",
              "orient": "left",
              "gridScale": "x",
              "grid": true,
              "tickCount": {
                "signal": "ceil(child_child_height/40)"
              },
              "domain": false,
              "labels": false,
              "aria": false,
              "maxExtent": 0,
              "minExtent": 0,
              "ticks": false,
              "zindex": 0
            }
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "field": "x"
      },
      "range": [
        0,
        {
          "signal": "child_child_width"
        }
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_2",
        "field": "y"
      },
      "range": [
        {
          "signal": "child_child_height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ]
}
