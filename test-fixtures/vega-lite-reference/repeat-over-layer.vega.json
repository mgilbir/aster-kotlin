{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A repetition whose copies are *layered* rather than laid side by side — `{\"repeat\": {\"layer\": […]}}`. The other look-alike of a composition inside a layer, and allowed where that is not: the repeat is above the layer here, not inside it.",
  "background": "white",
  "padding": 5,
  "width": 20,
  "height": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "x": 1,
          "y": 2
        },
        {
          "x": 3,
          "y": 4
        }
      ]
    },
    {
      "name": "data_1",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"x\"]) && isFinite(+datum[\"x\"])"
        }
      ]
    },
    {
      "name": "data_2",
      "source": "source_0",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum[\"y\"]) && isFinite(+datum[\"y\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "child__layer_x_marks",
      "type": "symbol",
      "style": [
        "point"
      ],
      "from": {
        "data": "data_1"
      },
      "encode": {
        "update": {
          "opacity": {
            "value": 0.7
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "point"
          },
          "description": {
            "signal": "\"x: \" + (format(datum[\"x\"], \"\"))"
          },
          "x": {
            "signal": "width",
            "mult": 0.5
          },
          "y": {
            "scale": "y",
            "field": "x"
          }
        }
      }
    },
    {
      "name": "child__layer_y_marks",
      "type": "symbol",
      "style": [
        "point"
      ],
      "from": {
        "data": "data_2"
      },
      "encode": {
        "update": {
          "opacity": {
            "value": 0.7
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "point"
          },
          "description": {
            "signal": "\"y: \" + (format(datum[\"y\"], \"\"))"
          },
          "x": {
            "signal": "width",
            "mult": 0.5
          },
          "y": {
            "scale": "y",
            "field": "y"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "fields": [
          {
            "data": "data_1",
            "field": "x"
          },
          {
            "data": "data_2",
            "field": "y"
          }
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "x, y",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ]
}
