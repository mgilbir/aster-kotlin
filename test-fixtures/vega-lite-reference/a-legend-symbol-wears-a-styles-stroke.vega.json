{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The other half of `a-legend-symbol-wears-the-marks-stroke`: a style the mark **names**, and a value written as an expression. A mark's styles are its own type followed by whatever its `style` names — `getStyles` is `[].concat(mark.type, mark.style ?? [])` — and `getStyleConfig` walks them in that order with the last one that speaks winning. So `config.style.outlined` reaches a bar that asks for it, and the swatch is outlined the way the bar is. The width is an **expression**, which `applyMarkConfig` passes through `signalOrValueRef`, so what lands on the swatch is a signal rather than a value wrapped around an object — written as a value, Vega is handed `{\"value\": {\"expr\": …}}` and draws an outline of nothing. This is a chart of its own rather than a second row beside the other fixture because two size legends over the same field are hoisted into a single legend, and the second of them would then never be drawn.",
  "background": "white",
  "padding": 5,
  "width": 200,
  "height": 70,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "c": "alpha",
          "v": 28
        },
        {
          "c": "beta",
          "v": 55
        },
        {
          "c": "gamma",
          "v": 43
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "c"
          ],
          "field": "v",
          "sort": {
            "field": [
              "v"
            ],
            "order": [
              "descending"
            ]
          },
          "as": [
            "v_start",
            "v_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar",
        "outlined"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
          },
          "xc": {
            "scale": "x",
            "field": "c",
            "band": 0.5
          },
          "width": {
            "scale": "size",
            "field": "v"
          },
          "y": {
            "scale": "y",
            "field": "v_end"
          },
          "y2": {
            "scale": "y",
            "field": "v_start"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "data_0",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": [
          "v_start",
          "v_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "size",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "field": "v"
      },
      "range": [
        2,
        19
      ],
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "c",
      "labelAlign": "right",
      "labelAngle": 270,
      "labelBaseline": "middle",
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "v",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ],
  "legends": [
    {
      "size": "size",
      "symbolType": "square",
      "title": "v",
      "encode": {
        "symbols": {
          "update": {
            "stroke": {
              "value": "#8b1a1a"
            },
            "strokeWidth": {
              "signal": "2 + 3"
            },
            "fill": {
              "value": "#4c78a8"
            }
          }
        }
      }
    }
  ],
  "config": {
    "style": {
      "outlined": {
        "stroke": "#8b1a1a",
        "strokeWidth": {
          "signal": "2 + 3"
        }
      }
    }
  }
}
