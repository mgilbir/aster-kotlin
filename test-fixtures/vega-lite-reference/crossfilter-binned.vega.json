                "offset": {
                  "signal": "0.5 + (abs(scale(\"child__column_Acceleration_x\", datum[\"bin_maxbins_20_Acceleration_end\"]) - scale(\"child__column_Acceleration_x\", datum[\"bin_maxbins_20_Acceleration\"])) < 0.25 ? 0.5 * (0.25 - (abs(scale(\"child__column_Acceleration_x\", datum[\"bin_maxbins_20_Acceleration_end\"]) - scale(\"child__column_Acceleration_x\", datum[\"bin_maxbins_20_Acceleration\"])))) : -0.5)"
