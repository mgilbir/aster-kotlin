{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A stacked area over a bucketed column, whose gaps are filled at the bucket's midpoint.",
  "background": "white",
  "padding": 5,
  "width": 300,
  "height": 300,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "url": "data/cars.json",
      "format": {
        "type": "json",
        "parse": {
          "Acceleration": "number"
        }
      },
      "transform": [
        {
          "type": "extent",
          "field": "Acceleration",
          "signal": "bin_maxbins_10_Acceleration_extent"
        },
        {
          "type": "bin",
          "field": "Acceleration",
          "as": [
            "bin_maxbins_10_Acceleration",
            "bin_maxbins_10_Acceleration_end"
          ],
          "signal": "bin_maxbins_10_Acceleration_bins",
          "extent": {
            "signal": "bin_maxbins_10_Acceleration_extent"
          },
          "maxbins": 10
        },
        {
          "type": "aggregate",
          "groupby": [
            "bin_maxbins_10_Acceleration",
            "bin_maxbins_10_Acceleration_end",
            "Origin"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "__count"
          ]
        },
        {
          "type": "formula",
          "expr": "isValid(datum[\"bin_maxbins_10_Acceleration\"]) && isFinite(+datum[\"bin_maxbins_10_Acceleration\"]) ? 0.5*datum[\"bin_maxbins_10_Acceleration\"]+0.5*datum[\"bin_maxbins_10_Acceleration_end\"] : datum[\"bin_maxbins_10_Acceleration\"]",
          "as": "bin_maxbins_10_Acceleration_mid"
        },
        {
          "type": "impute",
          "field": "__count",
          "groupby": [
            "Origin"
          ],
          "key": "bin_maxbins_10_Acceleration_mid",
          "method": "value",
          "value": 0
        },
        {
          "type": "stack",
          "groupby": [
            "bin_maxbins_10_Acceleration_mid"
          ],
          "field": "__count",
          "sort": {
            "field": [
              "Origin"
            ],
            "order": [
              "descending"
            ]
          },
          "as": [
            "__count_start",
            "__count_end"
          ],
          "offset": "zero"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "pathgroup",
      "type": "group",
      "from": {
        "facet": {
          "name": "faceted_path_main",
          "data": "source_0",
          "groupby": [
            "Origin"
          ]
        }
      },
      "encode": {
        "update": {
          "width": {
            "field": {
              "group": "width"
            }
          },
          "height": {
            "field": {
              "group": "height"
            }
          }
        }
      },
      "marks": [
        {
          "name": "marks",
          "type": "area",
          "style": [
            "area"
          ],
          "sort": {
            "field": "x"
          },
          "from": {
            "data": "faceted_path_main"
          },
          "encode": {
            "update": {
              "orient": {
                "value": "vertical"
              },
              "fill": {
                "scale": "color",
                "field": "Origin"
              },
              "description": {
                "signal": "\"Acceleration (binned): \" + (!isValid(datum[\"bin_maxbins_10_Acceleration\"]) || !isFinite(+datum[\"bin_maxbins_10_Acceleration\"]) ? \"null\" : format(datum[\"bin_maxbins_10_Acceleration\"], \"\") + \" – \" + format(datum[\"bin_maxbins_10_Acceleration_end\"], \"\")) + \"; Count of Records: \" + (format(datum[\"__count\"], \"\")) + \"; Origin: \" + (isValid(datum[\"Origin\"]) ? isArray(datum[\"Origin\"]) ? join(datum[\"Origin\"], ' ') : datum[\"Origin\"] : \"\"+datum[\"Origin\"])"
              },
              "x": {
                "scale": "x",
                "field": "bin_maxbins_10_Acceleration_mid"
              },
              "y": {
                "scale": "y",
                "field": "__count_end"
              },
              "y2": {
                "scale": "y",
                "field": "__count_start"
              },
              "defined": {
                "signal": "isValid(datum[\"bin_maxbins_10_Acceleration_mid\"]) && isFinite(+datum[\"bin_maxbins_10_Acceleration_mid\"])"
              }
            }
          }
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "signal": "[bin_maxbins_10_Acceleration_bins.start, bin_maxbins_10_Acceleration_bins.stop]"
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "bins": {
        "signal": "bin_maxbins_10_Acceleration_bins"
      },
      "zero": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "source_0",
        "fields": [
          "__count_start",
          "__count_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "source_0",
        "field": "Origin",
        "sort": true
      },
      "range": "category"
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "Acceleration (binned)",
      "labelFlush": true,
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(width/10)"
      },
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "Count of Records",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ],
  "legends": [
    {
      "fill": "color",
      "symbolType": "circle",
      "title": "Origin"
    }
  ]
}
