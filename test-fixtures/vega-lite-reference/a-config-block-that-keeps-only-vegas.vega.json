{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Two blocks that must hand Vega only the words Vega knows. `config.view` is one of the **mark** blocks, not a shape of its own: `MARK_STYLES = new Set(['view', ...PRIMITIVE_MARKS])`, and the loop over it deletes the generic `VL_ONLY_MARK_CONFIG_PROPERTIES` from every member *and then* whatever that member has in the mark-specific table, where `view`'s entry is its five sizes. This compiler dropped the sizes and kept the rest, so `config.view.invalid` — a word Vega has never heard — was renamed into the `cell` style and shipped. And `config.mark.tooltip` written as an **object** is spent while compiling rather than passed on: `if (config.mark.tooltip && isObject(config.mark.tooltip)) delete config.mark.tooltip`, because `{\"content\": \"data\"}` says which fields to show, which is a question only Vega-Lite can answer. A bare `true` is Vega's own switch and travels through, which is the case that must not move — as are `view`'s `fill` and `stroke`, which are Vega's words for a plotting area's paint and reach the `cell` style intact.",
  "background": "white",
  "padding": 5,
  "width": 200,
  "height": 70,
  "style": "cell",
  "data": [
    {
      "name": "source_0",
      "values": [
        {
          "c": "alpha",
          "v": 28
        },
        {
          "c": "beta",
          "v": 55
        }
      ]
    },
    {
      "name": "data_0",
      "source": "source_0",
      "transform": [
        {
          "type": "stack",
          "groupby": [
            "c"
          ],
          "field": "v",
          "sort": {
            "field": [],
            "order": []
          },
          "as": [
            "v_start",
            "v_end"
          ],
          "offset": "zero"
        },
        {
          "type": "filter",
          "expr": "isValid(datum[\"v\"]) && isFinite(+datum[\"v\"])"
        }
      ]
    }
  ],
  "marks": [
    {
      "name": "marks",
      "type": "rect",
      "style": [
        "bar"
      ],
      "from": {
        "data": "data_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#4c78a8"
          },
          "tooltip": {
            "signal": "datum"
          },
          "ariaRoleDescription": {
            "value": "bar"
          },
          "description": {
            "signal": "\"c: \" + (isValid(datum[\"c\"]) ? isArray(datum[\"c\"]) ? join(datum[\"c\"], ' ') : datum[\"c\"] : \"\"+datum[\"c\"]) + \"; v: \" + (format(datum[\"v\"], \"\"))"
          },
          "x": {
            "scale": "x",
            "field": "c"
          },
          "width": {
            "signal": "max(0.25, bandwidth('x'))"
          },
          "y": {
            "scale": "y",
            "field": "v_end"
          },
          "y2": {
            "scale": "y",
            "field": "v_start"
          }
        }
      }
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "data_0",
        "field": "c",
        "sort": true
      },
      "range": [
        0,
        {
          "signal": "width"
        }
      ],
      "paddingInner": 0.1,
      "paddingOuter": 0.05
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "data_0",
        "fields": [
          "v_start",
          "v_end"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        0
      ],
      "nice": true,
      "zero": true
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "gridScale": "x",
      "grid": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "domain": false,
      "labels": false,
      "aria": false,
      "maxExtent": 0,
      "minExtent": 0,
      "ticks": false,
      "zindex": 0
    },
    {
      "scale": "x",
      "orient": "bottom",
      "grid": false,
      "title": "c",
      "labelAlign": "right",
      "labelAngle": 270,
      "labelBaseline": "middle",
      "zindex": 0
    },
    {
      "scale": "y",
      "orient": "left",
      "grid": false,
      "title": "v",
      "labelOverlap": true,
      "tickCount": {
        "signal": "ceil(height/40)"
      },
      "zindex": 0
    }
  ],
  "config": {
    "mark": {
      "opacity": 0.8
    },
    "style": {
      "cell": {
        "fill": "#eeeeee",
        "stroke": "#999999"
      }
    }
  }
}
