<?xml version="1.0" encoding="utf-8"?>
<!-- The demo holds no user data worth preserving: exports are written to the cache directory. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
